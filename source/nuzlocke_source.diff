+// ---------------------------------------------------------------- drawing
+
+static void NuzScreen_InitDisplay(NuzlockeScreen *scr) {
+    int i;
+
+    scr->savedBanks.bg = GX_GetBankForBG();
+    scr->savedBanks.bgextpltt = GX_GetBankForBGExtPltt();
+    scr->savedBanks.subbg = GX_GetBankForSubBG();
+    scr->savedBanks.subbgextpltt = GX_GetBankForSubBGExtPltt();
+    scr->savedBanks.obj = GX_GetBankForOBJ();
+    scr->savedBanks.objextpltt = GX_GetBankForOBJExtPltt();
+    scr->savedBanks.subobj = GX_GetBankForSubOBJ();
+    scr->savedBanks.subobjextpltt = GX_GetBankForSubOBJExtPltt();
+    scr->savedBanks.tex = GX_GetBankForTex();
+    scr->savedBanks.texpltt = GX_GetBankForTexPltt();
+    scr->savedDispA = reg_GX_DISPCNT;
+    scr->savedBg2Cnt = reg_G2_BG2CNT;
+    scr->savedBackdrop = *(vu16 *)HW_BG_PLTT;
+
+    scr->bgConfig = BgConfig_Alloc(HEAP_ID_FIELD2);
+    // Only the top screen is changed; the bottom screen is left alone.
+    GraphicsBanks banks = sNzGraphicsBanks;
+    banks.subbg = scr->savedBanks.subbg;
+    banks.subbgextpltt = scr->savedBanks.subbgextpltt;
+    banks.subobj = scr->savedBanks.subobj;
+    banks.subobjextpltt = scr->savedBanks.subobjextpltt;
+    sub_0200FBF4(PM_LCD_TOP, RGB_BLACK);
+    ResetVisibleHardwareWindows(PM_LCD_TOP);
+    GfGfx_SetBanks(&banks);
+    SetScreenModeAndDisable(&sNzGraphicsModes, SCREEN_MAIN);
+    InitBgFromTemplate(scr->bgConfig, NZ_LAYER, &sNzBgTemplate, GF_BG_TYPE_TEXT);
+    BgClearTilemapBufferAndCommit(scr->bgConfig, NZ_LAYER);
+    BgSetPosTextAndCommit(scr->bgConfig, NZ_LAYER, BG_POS_OP_SET_X, 0);
+    BgSetPosTextAndCommit(scr->bgConfig, NZ_LAYER, BG_POS_OP_SET_Y, 0);
+
+    DC_FlushRange((void *)sUiPalette, sizeof(sUiPalette));
+    GX_LoadBGPltt(sUiPalette, NZ_PLTT_UI * 0x20, 0x20);
+    scr->iconPlttRaw = GfGfxLoader_GetPlttData(NARC_poketool_icongra_poke_icon, sub_02074490(), &scr->iconPltt, HEAP_ID_FIELD2);
+    DC_FlushRange(scr->iconPltt->pRawData, 0x80);
+    GX_LoadBGPltt(scr->iconPltt->pRawData, NZ_PLTT_ICON_BASE * 0x20, 0x80);
+    BG_SetMaskColor(NZ_LAYER, NZ_BACKDROP);
+
+    scr->msgData = NewMsgDataFromNarc(MSGDATA_LOAD_LAZY, NARC_msgdata_msg, msg_0203, HEAP_ID_FIELD2);
+    scr->msgFmt = MessageFormat_New(HEAP_ID_FIELD2);
+
+    u16 baseTile = 1;
+    AddWindowParameterized(scr->bgConfig, &scr->windows[WIN_BANNER], NZ_LAYER, 0, BANNER_Y, 32, BANNER_H, NZ_PLTT_UI, baseTile);
+    baseTile += 32 * BANNER_H;
+    AddWindowParameterized(scr->bgConfig, &scr->windows[WIN_INFO], NZ_LAYER, 0, INFO_Y, 32, INFO_H, NZ_PLTT_UI, baseTile);
+    baseTile += 32 * INFO_H;
+    for (i = 0; i < PARTY_SIZE; i++) {
+        u8 cardX = 1 + (i % 3) * CARD_W;
+        u8 cardY = CARD_ICON_Y + (i / 3) * CARD_ROW_STEP;
+        AddWindowParameterized(scr->bgConfig, &scr->windows[WIN_ICON_FIRST + i], NZ_LAYER, cardX + 3, cardY, 4, 4, NZ_PLTT_ICON_BASE, baseTile);
+        baseTile += 16;
+        AddWindowParameterized(scr->bgConfig, &scr->windows[WIN_PLATE_FIRST + i], NZ_LAYER, cardX, cardY + 4, CARD_W, CARD_PLATE_H, NZ_PLTT_UI, baseTile);
+        baseTile += CARD_W * CARD_PLATE_H;
+    }
+    scr->displayReady = TRUE;
+}
+
+static void NuzScreen_FreeDisplay(NuzlockeScreen *scr) {
+    int i;
+    if (!scr->displayReady) {
+        return;
+    }
+    for (i = 0; i < WIN_COUNT; i++) {
+        RemoveWindow(&scr->windows[i]);
+    }
+    // Wipe the layer so nothing is left on screen when the overworld returns.
+    BgClearTilemapBufferAndCommit(scr->bgConfig, NZ_LAYER);
+    ToggleBgLayer(NZ_LAYER, GF_PLANE_TOGGLE_OFF);
+
+    // Put the display back exactly as we found it.
+    GfGfx_SetBanks(&scr->savedBanks);
+    reg_G2_BG2CNT = scr->savedBg2Cnt;
+    *(vu16 *)HW_BG_PLTT = scr->savedBackdrop;
+    reg_GX_DISPCNT = scr->savedDispA;
+    GfGfx_EngineASetPlanes((scr->savedDispA >> 8) & 0x1F);
+    SetBlendBrightness(0, (GXBlendPlaneMask)(GX_BLEND_PLANEMASK_BD | GX_BLEND_PLANEMASK_OBJ | GX_BLEND_PLANEMASK_BG3 | GX_BLEND_PLANEMASK_BG2 | GX_BLEND_PLANEMASK_BG1 | GX_BLEND_PLANEMASK_BG0), SCREEN_MASK_MAIN | SCREEN_MASK_SUB);
+    MessageFormat_Delete(scr->msgFmt);
+    DestroyMsgData(scr->msgData);
+    Heap_Free(scr->iconPlttRaw);
+    FreeBgTilemapBuffer(scr->bgConfig, NZ_LAYER);
+    Heap_Free(scr->bgConfig);
+    scr->displayReady = FALSE;
+}
+
+static void NuzScreen_PrintFont(NuzlockeScreen *scr, Window *window, s32 msgNo, int y, u8 fg, u8 bg, BOOL center, int xOffset) {
+    String *tmpStr = String_New(256, HEAP_ID_FIELD2);
+    String *finStr = String_New(256, HEAP_ID_FIELD2);
+    int x = xOffset;
+    enum Font font = FONT_SYSTEM;
+    int width;
+
+    ReadMsgDataIntoString(scr->msgData, msgNo, tmpStr);
+    StringExpandPlaceholders(scr->msgFmt, finStr, tmpStr);
+    width = FontID_String_GetWidth(font, finStr, 0);
+    if (center) {
+        x = window->width * 8 > width ? (window->width * 8 - width) / 2 : 0;
+    }
+    AddTextPrinterParameterizedWithColor(window, font, finStr, x, y, TEXT_SPEED_NOTRANSFER, MAKE_TEXT_COLOR(fg, NZC_SHADOW, bg), NULL);
+
+    String_Delete(tmpStr);
+    String_Delete(finStr);
+}
+
+static void NuzScreen_Print(NuzlockeScreen *scr, Window *window, s32 msgNo, int y, u8 fg, u8 bg, BOOL center, int xOffset) {
+    NuzScreen_PrintFont(scr, window, msgNo, y, fg, bg, center, xOffset);
+}
+
+static void NuzScreen_DrawIcon(NuzlockeScreen *scr, Window *window, const NuzlockeTeamMon *mon) {
+    NNSG2dCharacterData *charData;
+    void *raw = GfGfxLoader_GetCharData(NARC_poketool_icongra_poke_icon, GetMonIconNaixEx(mon->species, FALSE, mon->form), FALSE, &charData, HEAP_ID_FIELD2);
+    // First animation frame: 32x32 pixels = 16 tiles, same order as a 4x4 window.
+    MI_CpuCopy8(charData->pRawData, window->pixelBuffer, 0x200);
+    Heap_Free(raw);
+    window->paletteNum = NZ_PLTT_ICON_BASE + GetMonIconPaletteEx(mon->species, mon->form, FALSE);
+}
+
+static void NuzScreen_DrawBanner(NuzlockeScreen *scr, s32 titleMsg, u8 bannerColor) {
+    Window *banner = &scr->windows[WIN_BANNER];
+    FillWindowPixelBuffer(banner, bannerColor);
+    FillWindowPixelRect(banner, NZC_DARK, 0, BANNER_H * 8 - 2, 256, 2);
+    NuzScreen_Print(scr, banner, titleMsg, 4, NZC_WHITE, bannerColor, TRUE, 0);
+    if (scr->numPages > 1) {
+        BufferIntegerAsString(scr->msgFmt, 0, scr->page + 1, 2, PRINTING_MODE_LEFT_ALIGN, TRUE);
+        BufferIntegerAsString(scr->msgFmt, 1, scr->numPages, 2, PRINTING_MODE_LEFT_ALIGN, TRUE);
+        NuzScreen_Print(scr, banner, msg_0203_00026, 4, NZC_WHITE, bannerColor, FALSE, scr->numPages > 9 ? 256 - 40 : 256 - 28);
+    }
+    CopyWindowToVram(banner);
+}
+
+static void NuzScreen_DrawLogPage(NuzlockeScreen *scr, SaveData *saveData) {
+    int logCount = Nuzlocke_GetLogCount(saveData);
+    int first = scr->pageArg[scr->page] * PARTY_SIZE;
+    int caught = 0;
+    int i;
+    IGT *igt = Save_PlayerData_GetIGTAddr(saveData);
+
+    for (i = 0; i < logCount; i++) {
+        if (Nuzlocke_GetLogEntry(saveData, i)->status == NUZLOCKE_LOG_CAUGHT) {
+            caught++;
+        }
+    }
+
+    NuzScreen_DrawBanner(scr, msg_0203_00020, NZC_GREEN); // ENCOUNTER LOG
+
+    Window *info = &scr->windows[WIN_INFO];
+    FillWindowPixelBuffer(info, NZC_CLEAR);
+    BufferIntegerAsString(scr->msgFmt, 0, caught, 3, PRINTING_MODE_LEFT_ALIGN, TRUE);
+    BufferIntegerAsString(scr->msgFmt, 1, logCount - caught, 3, PRINTING_MODE_LEFT_ALIGN, TRUE);
+    BufferIntegerAsString(scr->msgFmt, 2, Nuzlocke_GetDeaths(saveData), 3, PRINTING_MODE_LEFT_ALIGN, TRUE);
+    NuzScreen_Print(scr, info, msg_0203_00021, 1, NZC_GOLD_TEXT, NZC_CLEAR, TRUE, 0);
+    BufferPlayersName(scr->msgFmt, 0, Save_PlayerData_GetProfile(saveData));
+    BufferIntegerAsString(scr->msgFmt, 1, PlayerProfile_CountBadges(Save_PlayerData_GetProfile(saveData)), 2, PRINTING_MODE_LEFT_ALIGN, TRUE);
+    BufferIntegerAsString(scr->msgFmt, 2, GetIGTHours(igt), 3, PRINTING_MODE_LEFT_ALIGN, TRUE);
+    BufferIntegerAsString(scr->msgFmt, 3, GetIGTMinutes(igt), 2, PRINTING_MODE_LEADING_ZEROS, TRUE);
+    NuzScreen_Print(scr, info, msg_0203_00022, 16, NZC_GREY, NZC_CLEAR, TRUE, 0);
+    CopyWindowToVram(info);
+
+    for (i = 0; i < PARTY_SIZE; i++) {
+        Window *icon = &scr->windows[WIN_ICON_FIRST + i];
+        Window *plate = &scr->windows[WIN_PLATE_FIRST + i];
+        if (first + i < logCount) {
+            const NuzlockeLogEntry *entry = Nuzlocke_GetLogEntry(saveData, first + i);
+            BOOL ok = entry->status == NUZLOCKE_LOG_CAUGHT;
+            NuzlockeTeamMon mon;
+
+            MI_CpuClear8(&mon, sizeof(mon));
+            mon.species = entry->species;
+            NuzScreen_DrawIcon(scr, icon, &mon);
+
+            FillWindowPixelBuffer(plate, NZC_PANEL);
+            FillWindowPixelRect(plate, ok ? NZC_GREEN : NZC_RED, 0, 0, CARD_W * 8, 2);
+            BufferSpeciesName(scr->msgFmt, 0, entry->species);
+            NuzScreen_Print(scr, plate, ok ? msg_0203_00024 : msg_0203_00025, 2, ok ? NZC_GREEN_TEXT : NZC_RED_TEXT, NZC_PANEL, TRUE, 0);
+            BufferLocationName(scr->msgFmt, 0, entry->mapsec);
+            NuzScreen_Print(scr, plate, msg_0203_00023, 16, NZC_GREY, NZC_PANEL, TRUE, 0);
+            // Thin dividers so long place names don't run into the next card.
+            FillWindowPixelRect(plate, NZC_DARK, 0, 2, 1, CARD_PLATE_H * 8 - 2);
+            FillWindowPixelRect(plate, NZC_DARK, CARD_W * 8 - 1, 2, 1, CARD_PLATE_H * 8 - 2);
+        } else {
+            FillWindowPixelBuffer(icon, 0);
+            icon->paletteNum = NZ_PLTT_UI;
+            FillWindowPixelBuffer(plate, NZC_CLEAR);
+        }
+        CopyWindowToVram(icon);
+        CopyWindowToVram(plate);
+    }
+}
+
+static void NuzScreen_DrawPage(NuzlockeScreen *scr, SaveData *saveData) {
+    const NuzlockeRecord *rec;
+    int pageKind = scr->pages[scr->page];
+    u8 bannerColor;
+    s32 titleMsg;
+    int i;
+
+    if (pageKind == NZ_PAGE_LOG) {
+        NuzScreen_DrawLogPage(scr, saveData);
+        return;
+    }
+
+    switch (pageKind) {
+    case NZ_PAGE_RUN_OVER:
+        bannerColor = NZC_RED;
+        titleMsg = msg_0203_00006; // NUZLOCKE RUN OVER
+        rec = &scr->live;
+        break;
+    case NZ_PAGE_LIVE:
+        bannerColor = NZC_BLUE;
+        titleMsg = msg_0203_00015; // NUZLOCKE IN PROGRESS
+        if (Nuzlocke_IsTestMode()) {
+            bannerColor = NZC_RED;
+            titleMsg = msg_0203_00019; // TEST MODE - NOT SAVED
+        }
+        rec = &scr->live;
+        break;
+    case NZ_PAGE_CHAMPION:
+        bannerColor = NZC_GOLD;
+        titleMsg = msg_0203_00013; // ELITE FOUR CONQUERED!
+        rec = &Save_Nuzlocke_Get(saveData)->records[NUZLOCKE_RECORD_CHAMPION];
+        break;
+    case NZ_PAGE_RED:
+    default:
+        bannerColor = NZC_GOLD;
+        titleMsg = msg_0203_00014; // RED DEFEATED!
+        rec = &Save_Nuzlocke_Get(saveData)->records[NUZLOCKE_RECORD_RED];
+        break;
+    }
+
+    // Title banner (with page number when there is more than one page)
+    NuzScreen_DrawBanner(scr, titleMsg, bannerColor);
+
+    // Info lines
+    Window *info = &scr->windows[WIN_INFO];
+    FillWindowPixelBuffer(info, NZC_CLEAR);
+    BufferPlayersName(scr->msgFmt, 0, Save_PlayerData_GetProfile(saveData));
+    BufferIntegerAsString(scr->msgFmt, 1, rec->badges, 2, PRINTING_MODE_LEFT_ALIGN, TRUE);
+    BufferIntegerAsString(scr->msgFmt, 2, rec->deaths, 3, PRINTING_MODE_LEFT_ALIGN, TRUE);
+    NuzScreen_Print(scr, info, msg_0203_00012, 1, NZC_GOLD_TEXT, NZC_CLEAR, TRUE, 0);
+    BufferIntegerAsString(scr->msgFmt, 0, rec->hours, 3, PRINTING_MODE_LEFT_ALIGN, TRUE);
+    BufferIntegerAsString(scr->msgFmt, 1, rec->minutes, 2, PRINTING_MODE_LEADING_ZEROS, TRUE);
+    BufferIntegerAsString(scr->msgFmt, 2, rec->caught, 3, PRINTING_MODE_LEFT_ALIGN, TRUE);
+    NuzScreen_Print(scr, info, msg_0203_00009, 16, NZC_GREY, NZC_CLEAR, TRUE, 0);
+    CopyWindowToVram(info);
+
+    // Team cards
+    for (i = 0; i < PARTY_SIZE; i++) {
+        Window *icon = &scr->windows[WIN_ICON_FIRST + i];
+        Window *plate = &scr->windows[WIN_PLATE_FIRST + i];
+        if (i < rec->teamCount) {
+            const NuzlockeTeamMon *mon = &rec->team[i];
+            String *nick = String_New(POKEMON_NAME_LENGTH + 1, HEAP_ID_FIELD2);
+
+            NuzScreen_DrawIcon(scr, icon, mon);
+
+            FillWindowPixelBuffer(plate, NZC_PANEL);
+            FillWindowPixelRect(plate, bannerColor, 0, 0, CARD_W * 8, 2);
+            CopyU16ArrayToString(nick, mon->nickname);
+            BufferString(scr->msgFmt, 0, nick, 0, 1, 2);
+            NuzScreen_Print(scr, plate, msg_0203_00016, 2, NZC_WHITE, NZC_PANEL, TRUE, 0);
+            BufferIntegerAsString(scr->msgFmt, 0, mon->level, 3, PRINTING_MODE_LEFT_ALIGN, TRUE);
+            NuzScreen_Print(scr, plate, msg_0203_00017, 16, pageKind == NZ_PAGE_RUN_OVER ? NZC_RED_TEXT : NZC_GOLD_TEXT, NZC_PANEL, TRUE, 0);
+            String_Delete(nick);
+        } else {
+            FillWindowPixelBuffer(icon, 0);
+            icon->paletteNum = NZ_PLTT_UI;
+            FillWindowPixelBuffer(plate, NZC_CLEAR);
+        }
+        CopyWindowToVram(icon);
+        CopyWindowToVram(plate);
+    }
+}
+
+// ---------------------------------------------------------------- task
+
+enum {
+    NZS_STATE_PREPARE,
+    NZS_STATE_SOUND_FADE_WAIT,
+    NZS_STATE_DRAW,
+    NZS_STATE_FADE_IN_WAIT,
+    NZS_STATE_INPUT,
+    NZS_STATE_FADE_OUT_WAIT,
+};
+
+static BOOL Task_NuzlockeScreen(TaskManager *taskManager) {
+    FieldSystem *fieldSystem = TaskManager_GetFieldSystem(taskManager);
+    NuzlockeScreen *scr = TaskManager_GetEnvironment(taskManager);
+    u32 *state = TaskManager_GetStatePtr(taskManager);
+
+    switch (*state) {
+    case NZS_STATE_PREPARE:
+        if (scr->mode == NZ_MODE_RUN_OVER) {
+            // Lock the finished run into the save file. The final team is
+            // healed first: the overworld (walking Pokemon) can't load with an
+            // all-fainted party, and the screen doesn't show HP.
+            HealParty(SaveArray_Party_Get(fieldSystem->saveData));
+            SaveGameNormal(fieldSystem->saveData);
+            GF_SndStartFadeOutBGM(0, 20);
+            *state = NZS_STATE_SOUND_FADE_WAIT;
+        } else {
+            *state = NZS_STATE_DRAW;
+        }
+        break;
+    case NZS_STATE_SOUND_FADE_WAIT:
+        if (GF_SndGetFadeTimer() == 0) {
+            FieldBGM_Stop();
+            *state = NZS_STATE_DRAW;
+        }
+        break;
+    case NZS_STATE_DRAW:
+        Nuzlocke_FillRecord(fieldSystem->saveData, &scr->live);
+        NuzScreen_InitDisplay(scr);
+        if (scr->mode == NZ_MODE_RUN_OVER) {
+            // The game never goes back from here: blank the bottom screen too.
+            GfGfx_EngineBSetPlanes(0);
+            *(vu16 *)HW_DB_BG_PLTT = NZ_BACKDROP;
+            GXS_SetMasterBrightness(0);
+        }
+        NuzScreen_DrawPage(scr, fieldSystem->saveData);
+        G2_BlendNone();
+        BeginNormalPaletteFade(FADE_MAIN_ONLY, FADE_TYPE_BRIGHTNESS_IN, FADE_TYPE_UNK_43, RGB_BLACK, 8, 1, HEAP_ID_FIELD3);
+        *state = NZS_STATE_FADE_IN_WAIT;
+        break;
+    case NZS_STATE_FADE_IN_WAIT:
+        if (IsPaletteFadeFinished()) {
+            *state = NZS_STATE_INPUT;
+        }
+        break;
+    case NZS_STATE_INPUT: {
+        BOOL next = (gSystem.newKeys & (PAD_BUTTON_A | PAD_KEY_RIGHT)) || gSystem.touchNew;
+        BOOL prev = gSystem.newKeys & PAD_KEY_LEFT;
+        BOOL close = gSystem.newKeys & PAD_BUTTON_B;
+
+        if (scr->mode == NZ_MODE_RUN_OVER) {
+            close = FALSE; // the run is over: this screen never closes
+            if ((next || prev) && scr->numPages > 1) {
+                scr->page = next ? (scr->page + 1) % scr->numPages : (scr->page + scr->numPages - 1) % scr->numPages;
+                PlaySE(SEQ_SE_DP_SELECT);
+                NuzScreen_DrawPage(scr, fieldSystem->saveData);
+            }
+        } else {
+            if (prev && scr->page > 0) {
+                scr->page--;
+                PlaySE(SEQ_SE_DP_SELECT);
+                NuzScreen_DrawPage(scr, fieldSystem->saveData);
+            } else if (next && scr->page + 1 < scr->numPages) {
+                scr->page++;
+                PlaySE(SEQ_SE_DP_SELECT);
+                NuzScreen_DrawPage(scr, fieldSystem->saveData);
+            } else if (next) {
+                close = TRUE;
+            }
+        }
+        if (close) {
+            PlaySE(SEQ_SE_DP_SELECT);
+            BeginNormalPaletteFade(FADE_BOTH_SCREENS, FADE_TYPE_BRIGHTNESS_OUT, FADE_TYPE_BRIGHTNESS_OUT, RGB_BLACK, 8, 1, HEAP_ID_FIELD3);
+            *state = NZS_STATE_FADE_OUT_WAIT;
+        }
+        break;
+    }
+    case NZS_STATE_FADE_OUT_WAIT:
+        if (IsPaletteFadeFinished()) {
+            NuzScreen_FreeDisplay(scr);
+            Heap_Free(scr);
+            return TRUE;
+        }
+        break;
+    }
+    return FALSE;
+}
+
+// Run over: called with TaskManager_Jump(..., Task_NuzlockeRunOver, NULL)
+// right after the losing battle, or when continuing a finished run.
+BOOL Task_NuzlockeRunOver(TaskManager *taskManager) {
+    FieldSystem *fieldSystem = TaskManager_GetFieldSystem(taskManager);
+    NuzlockeScreen *scr = NuzScreen_New(NZ_MODE_RUN_OVER);
+
+    scr->pages[scr->numPages++] = NZ_PAGE_RUN_OVER;
+    NuzScreen_AddRecordPages(scr, fieldSystem->saveData);
+    SetBlendBrightness(-16, (GXBlendPlaneMask)(GX_BLEND_PLANEMASK_BD | GX_BLEND_PLANEMASK_OBJ | GX_BLEND_PLANEMASK_BG3 | GX_BLEND_PLANEMASK_BG2 | GX_BLEND_PLANEMASK_BG1 | GX_BLEND_PLANEMASK_BG0), SCREEN_MASK_MAIN | SCREEN_MASK_SUB);
+    TaskManager_Jump(taskManager, Task_NuzlockeScreen, scr);
+    return FALSE;
+}
+
+// Victory: called from the battle task after the overworld has been left,
+// before it is restored.
+void Nuzlocke_CallVictoryScreen(TaskManager *taskManager, int record) {
+    NuzlockeScreen *scr = NuzScreen_New(NZ_MODE_VICTORY);
+    scr->pages[scr->numPages++] = record == NUZLOCKE_RECORD_RED ? NZ_PAGE_RED : NZ_PAGE_CHAMPION;
+    PlaySE(SEQ_SE_DP_DENDOU); // Hall of Fame chime
+    TaskManager_Call(taskManager, Task_NuzlockeScreen, scr);
+}
+
+// ---------------------------------------------------------------- records (SELECT)
+
+static BOOL Task_NuzlockeRecords(TaskManager *taskManager) {
+    FieldSystem *fieldSystem = TaskManager_GetFieldSystem(taskManager);
+    NuzlockeScreen *scr = TaskManager_GetEnvironment(taskManager);
+    u32 *state = TaskManager_GetStatePtr(taskManager);
+
+    switch (*state) {
+    case 0:
+        MapObjectManager_PauseAllMovement(fieldSystem->mapObjectManager);
+        BeginNormalPaletteFade(FADE_BOTH_SCREENS, FADE_TYPE_BRIGHTNESS_OUT, FADE_TYPE_BRIGHTNESS_OUT, RGB_BLACK, 6, 1, HEAP_ID_FIELD3);
+        (*state)++;
+        break;
+    case 1:
+        if (IsPaletteFadeFinished()) {
+            CallTask_LeaveOverworld(taskManager);
+            (*state)++;
+        }
+        break;
+    case 2:
+        TaskManager_Call(taskManager, Task_NuzlockeScreen, scr);
+        (*state)++;
+        break;
+    case 3:
+        CallTask_RestoreOverworld(taskManager);
+        (*state)++;
+        break;
+    case 4:
+        CallTask_FadeFromBlack(taskManager);
+        (*state)++;
+        break;
+    case 5:
+        MapObjectManager_UnpauseAllMovement(fieldSystem->mapObjectManager);
+        return TRUE;
+    }
+    return FALSE;
+}
+
+void Nuzlocke_OpenRecords(FieldSystem *fieldSystem) {
+    NuzlockeScreen *scr = NuzScreen_New(NZ_MODE_RECORDS);
+    scr->pages[scr->numPages++] = NZ_PAGE_LIVE;
+    NuzScreen_AddRecordPages(scr, fieldSystem->saveData);
+    FieldSystem_CreateTask(fieldSystem, Task_NuzlockeRecords, scr);
+}
