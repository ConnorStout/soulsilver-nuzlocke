+// ------------------------------------------------------------------
+// Nuzlocke screens: run over, victory (Champion / Red) and the
+// records viewer (SELECT in the overworld).
+//
+// Everything is drawn on main BG2 as plain windows. Pokemon party icons
+// are 32x32 4bpp images stored in the same tile order as a 4x4-tile
+// window, so they are copied straight into small windows that use the
+// icon palettes.
+// ------------------------------------------------------------------
+#include "global.h"
+
+#include "constants/sndseq.h"
