+// Name, cause and place of a fallen Pokemon.
+static void NuzScreen_DrawDeathRow(NuzlockeScreen *scr, SaveData *saveData, int row, const NuzlockeDeath *info) {
+    Window *text = NuzScreen_BeginRow(scr, row, info->species, info->form, NZC_RED);
+    s32 causeMsg;
+
+    NuzScreen_BufferNick(scr, 0, info);
+    BufferSpeciesName(scr->msgFmt, 1, info->species);
+    BufferIntegerAsString(scr->msgFmt, 2, info->level, 3, PRINTING_MODE_LEFT_ALIGN, TRUE);
+    NuzScreen_Print(scr, text, NuzScreen_NameLineMsg(info), LIST_LINE_1, NZC_WHITE, NZC_PANEL, FALSE, 8);
+    causeMsg = NuzScreen_BufferCause(scr, saveData, info);
+    NuzScreen_Print(scr, text, causeMsg, LIST_LINE_2, NZC_RED_TEXT, NZC_PANEL, FALSE, 8);
+    BufferLocationName(scr->msgFmt, 0, info->mapsec);
+    NuzScreen_Print(scr, text, msg_0203_00023, LIST_LINE_3, NZC_GREY, NZC_PANEL, FALSE, 8);
+    NuzScreen_EndRow(scr, row);
+}
+
+static void NuzScreen_DrawMemorialPage(NuzlockeScreen *scr, SaveData *saveData) {
+    int count = Nuzlocke_GetDeathRecordCount(saveData);
+    int first = scr->pageArg[scr->page] * LIST_ROWS;
+    int i;
+
+    NuzScreen_DrawBanner(scr, msg_0203_00031, NZC_MEMORIAL); // IN MEMORIAM
+    for (i = 0; i < LIST_ROWS; i++) {
+        if (first + i < count) {
+            NuzScreen_DrawDeathRow(scr, saveData, i, Nuzlocke_GetDeathRecord(saveData, first + i));
+        } else {
+            NuzScreen_ClearRow(scr, i);
+        }
+    }
+}
+
+static void NuzScreen_DrawSavingPage(NuzlockeScreen *scr, SaveData *saveData, BOOL saved) {
+    int count = Nuzlocke_GetEventCount();
+    int i;
+
+    NuzScreen_DrawBanner(scr, saved ? msg_0203_00060 : msg_0203_00059, saved ? NZC_GREEN : NZC_BLUE);
+    for (i = 0; i < LIST_ROWS; i++) {
+        const NuzlockeEvent *event;
+        Window *text;
+        if (i >= count) {
+            if (i == 0) {
+                text = NuzScreen_BeginRow(scr, 0, SPECIES_NONE, 0, NZC_BLUE);
+                NuzScreen_Print(scr, text, msg_0203_00067, LIST_LINE_2, NZC_WHITE, NZC_PANEL, FALSE, 8);
+                NuzScreen_EndRow(scr, 0);
+            } else {
+                NuzScreen_ClearRow(scr, i);
+            }
+            continue;
+        }
+        event = Nuzlocke_GetEvent(i);
+        switch (event->kind) {
+        case NUZLOCKE_EVENT_CAUGHT:
+            text = NuzScreen_BeginRow(scr, i, event->info.species, event->info.form, NZC_GREEN);
+            NuzScreen_BufferNick(scr, 0, &event->info);
+            BufferSpeciesName(scr->msgFmt, 1, event->info.species);
+            BufferIntegerAsString(scr->msgFmt, 2, event->info.level, 3, PRINTING_MODE_LEFT_ALIGN, TRUE);
+            NuzScreen_Print(scr, text, NuzScreen_NameLineMsg(&event->info), LIST_LINE_1, NZC_WHITE, NZC_PANEL, FALSE, 8);
+            NuzScreen_Print(scr, text, event->detail ? msg_0203_00062 : msg_0203_00061, LIST_LINE_2, NZC_GREEN_TEXT, NZC_PANEL, FALSE, 8);
+            BufferLocationName(scr->msgFmt, 0, event->info.mapsec);
+            NuzScreen_Print(scr, text, msg_0203_00023, LIST_LINE_3, NZC_GREY, NZC_PANEL, FALSE, 8);
+            NuzScreen_EndRow(scr, i);
+            break;
+        case NUZLOCKE_EVENT_FAILED:
+            text = NuzScreen_BeginRow(scr, i, event->info.species, 0, NZC_RED);
+            BufferSpeciesName(scr->msgFmt, 0, event->info.species);
+            BufferIntegerAsString(scr->msgFmt, 1, event->info.level, 3, PRINTING_MODE_LEFT_ALIGN, TRUE);
+            NuzScreen_Print(scr, text, msg_0203_00065, LIST_LINE_1, NZC_WHITE, NZC_PANEL, FALSE, 8);
+            NuzScreen_Print(scr, text, event->detail == BATTLE_OUTCOME_WIN ? msg_0203_00063 : (event->detail == BATTLE_OUTCOME_PLAYER_FLED ? msg_0203_00079 : msg_0203_00064), LIST_LINE_2, NZC_RED_TEXT, NZC_PANEL, FALSE, 8);
+            BufferLocationName(scr->msgFmt, 0, event->info.mapsec);
+            NuzScreen_Print(scr, text, msg_0203_00023, LIST_LINE_3, NZC_GREY, NZC_PANEL, FALSE, 8);
+            NuzScreen_EndRow(scr, i);
+            break;
+        case NUZLOCKE_EVENT_DEATH:
+            NuzScreen_DrawDeathRow(scr, saveData, i, &event->info);
+            break;
+        case NUZLOCKE_EVENT_VICTORY:
+        default:
+            text = NuzScreen_BeginRow(scr, i, SPECIES_NONE, 0, NZC_GOLD);
+            NuzScreen_Print(scr, text, event->detail == NUZLOCKE_RECORD_RED ? msg_0203_00014 : msg_0203_00013, LIST_LINE_1, NZC_GOLD_TEXT, NZC_PANEL, FALSE, 8);
+            NuzScreen_Print(scr, text, msg_0203_00066, LIST_LINE_2, NZC_WHITE, NZC_PANEL, FALSE, 8);
+            NuzScreen_EndRow(scr, i);
+            break;
+        }
+    }
+}
+
+static void NuzScreen_DrawPage(NuzlockeScreen *scr, SaveData *saveData) {
+    const NuzlockeRecord *rec;
+    int pageKind = scr->pages[scr->page];
+    u8 bannerColor;
+    s32 titleMsg;
+    int i;
+
+    switch (pageKind) {
+    case NZ_PAGE_MEMORIAL:
+        NuzScreen_SetLayout(scr, NZ_LAYOUT_LIST);
+        NuzScreen_DrawMemorialPage(scr, saveData);
+        return;
+    case NZ_PAGE_SAVING:
+        NuzScreen_SetLayout(scr, NZ_LAYOUT_LIST);
+        NuzScreen_DrawSavingPage(scr, saveData, FALSE);
+        return;
+    case NZ_PAGE_LOG:
+        NuzScreen_SetLayout(scr, NZ_LAYOUT_CARDS);
+        NuzScreen_DrawLogPage(scr, saveData);
+        return;
+    }
+    NuzScreen_SetLayout(scr, NZ_LAYOUT_CARDS);
+
+    switch (pageKind) {
+    case NZ_PAGE_RUN_OVER:
+        bannerColor = NZC_RED;
+        titleMsg = msg_0203_00006; // NUZLOCKE RUN OVER
+        rec = &scr->live;
+        break;
+    case NZ_PAGE_LIVE:
+        bannerColor = NZC_BLUE;
+        titleMsg = msg_0203_00015; // NUZLOCKE IN PROGRESS
+        if (Nuzlocke_IsTestMode()) {
+            bannerColor = NZC_RED;
+            titleMsg = msg_0203_00019; // TEST MODE - NOT SAVED
+        }
+        rec = &scr->live;
+        break;
+    case NZ_PAGE_CHAMPION:
+        bannerColor = NZC_GOLD;
+        titleMsg = msg_0203_00013; // ELITE FOUR CONQUERED!
+        rec = &Save_Nuzlocke_Get(saveData)->records[NUZLOCKE_RECORD_CHAMPION];
+        break;
+    case NZ_PAGE_RED:
+    default:
+        bannerColor = NZC_GOLD;
+        titleMsg = msg_0203_00014; // RED DEFEATED!
+        rec = &Save_Nuzlocke_Get(saveData)->records[NUZLOCKE_RECORD_RED];
+        break;
+    }
+
+    // Title banner (with page number when there is more than one page)
+    NuzScreen_DrawBanner(scr, titleMsg, bannerColor);
+
+    // Info lines
+    Window *info = &scr->windows[WIN_INFO];
+    FillWindowPixelBuffer(info, NZC_CLEAR);
+    BufferPlayersName(scr->msgFmt, 0, Save_PlayerData_GetProfile(saveData));
+    BufferIntegerAsString(scr->msgFmt, 1, rec->badges, 2, PRINTING_MODE_LEFT_ALIGN, TRUE);
+    BufferIntegerAsString(scr->msgFmt, 2, rec->deaths, 3, PRINTING_MODE_LEFT_ALIGN, TRUE);
+    NuzScreen_Print(scr, info, msg_0203_00012, 1, NZC_GOLD_TEXT, NZC_CLEAR, TRUE, 0);
+    BufferIntegerAsString(scr->msgFmt, 0, rec->hours, 3, PRINTING_MODE_LEFT_ALIGN, TRUE);
+    BufferIntegerAsString(scr->msgFmt, 1, rec->minutes, 2, PRINTING_MODE_LEADING_ZEROS, TRUE);
+    BufferIntegerAsString(scr->msgFmt, 2, rec->caught, 3, PRINTING_MODE_LEFT_ALIGN, TRUE);
+    NuzScreen_Print(scr, info, msg_0203_00009, 16, NZC_GREY, NZC_CLEAR, TRUE, 0);
+    CopyWindowToVram(info);
+
+    // Team cards
+    for (i = 0; i < PARTY_SIZE; i++) {
+        Window *icon = &scr->windows[WIN_ICON_FIRST + i];
+        Window *plate = &scr->windows[WIN_PLATE_FIRST + i];
+        if (i < rec->teamCount) {
+            const NuzlockeTeamMon *mon = &rec->team[i];
+            String *nick = String_New(POKEMON_NAME_LENGTH + 1, HEAP_ID_FIELD2);
+
+            NuzScreen_DrawIcon(scr, icon, mon);
+
+            FillWindowPixelBuffer(plate, NZC_PANEL);
+            FillWindowPixelRect(plate, bannerColor, 0, 0, CARD_W * 8, 2);
+            CopyU16ArrayToString(nick, mon->nickname);
+            BufferString(scr->msgFmt, 0, nick, 0, 1, 2);
+            NuzScreen_Print(scr, plate, msg_0203_00016, 2, NZC_WHITE, NZC_PANEL, TRUE, 0);
+            BufferIntegerAsString(scr->msgFmt, 0, mon->level, 3, PRINTING_MODE_LEFT_ALIGN, TRUE);
+            NuzScreen_Print(scr, plate, msg_0203_00017, 16, pageKind == NZ_PAGE_RUN_OVER ? NZC_RED_TEXT : NZC_GOLD_TEXT, NZC_PANEL, TRUE, 0);
+            String_Delete(nick);
+        } else {
+            FillWindowPixelBuffer(icon, 0);
+            icon->paletteNum = NZ_PLTT_UI;
+            FillWindowPixelBuffer(plate, NZC_CLEAR);
+        }
+        CopyWindowToVram(icon);
+        CopyWindowToVram(plate);
+    }
+}
