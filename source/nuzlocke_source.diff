+BOOL Nuzlocke_IsCatchBlocked(void) {
+    return sCatchBlocked;
+}
+
+BOOL Nuzlocke_RulesActiveInBattle(void) {
+    return sRulesActiveInBattle;
+}
+
+// Called at the very start of a random wild encounter (grass, cave, water,
+// fishing, headbutt, rock smash, Safari Zone), while the overworld is
+// still loaded.
+BOOL Nuzlocke_OnRandomEncounterStart(FieldSystem *fieldSystem, BattleSetup *setup) {
+    sCatchBlocked = FALSE;
+    sRandomEncounter = TRUE;
+    sShinyEncounter = MonIsShiny(Party_GetMonByIndex(setup->party[BATTLER_ENEMY], 0));
+#if NUZLOCKE_ENCOUNTER_RULE
+    if (!Nuzlocke_UpdateRulesActive(fieldSystem->saveData)) {
+        return FALSE;
+    }
+    if (setup->battleType & (BATTLE_TYPE_TRAINER | BATTLE_TYPE_LINK | BATTLE_TYPE_ROAMER | BATTLE_TYPE_TUTORIAL | BATTLE_TYPE_PAL_PARK | BATTLE_TYPE_BUG_CONTEST | BATTLE_TYPE_FRONTIER)) {
+        return FALSE;
+    }
+
+    NuzlockeSave *nz = Save_Nuzlocke_Get(fieldSystem->saveData);
+    Pokemon *wildMon = Party_GetMonByIndex(setup->party[BATTLER_ENEMY], 0);
+    u32 mapsec = MapHeader_GetMapSec(fieldSystem->location->mapId);
+
+#if NUZLOCKE_SHINY_CLAUSE
+    if (MonIsShiny(wildMon)) {
+        // Shiny clause: always catchable, and doesn't use up the area.
+        return FALSE;
+    }
+#endif
+
+    if (Nuzlocke_IsAreaUsed(nz, mapsec)) {
+        sCatchBlocked = TRUE;
+        return FALSE;
+    }
+
+    // First encounter here: it counts whether it's caught, flees or faints.
+    // It's logged as failed now (so a reset can't undo it) and upgraded to
+    // caught when the battle ends with a capture.
+    Nuzlocke_SetAreaUsed(nz, mapsec);
+    Nuzlocke_SetLog(fieldSystem->saveData, mapsec, GetMonData(wildMon, MON_DATA_SPECIES, NULL), NUZLOCKE_LOG_FAILED);
+    sLogPending = TRUE;
+    sLogPendingMapsec = mapsec;
+    return TRUE;
+#else
+    return FALSE;
+#endif
+}
+
+void Nuzlocke_OnBattleStart(FieldSystem *fieldSystem) {
+    sRulesActiveInBattle = Nuzlocke_UpdateRulesActive(fieldSystem->saveData);
+    sCaughtValid = FALSE;
+    sEventCount = 0;
+    Nuzlocke_BattleReset();
+}
+
+static BOOL Nuzlocke_MonIsDead(Pokemon *mon) {
+    return GetMonData(mon, NUZLOCKE_DEAD_MARKER, NULL) != 0;
+}
+
+static BOOL Nuzlocke_MonCanFight(Pokemon *mon) {
+    return GetMonData(mon, MON_DATA_SPECIES_EXISTS, NULL)
+        && !GetMonData(mon, MON_DATA_IS_EGG, NULL)
+        && GetMonData(mon, MON_DATA_HP, NULL) != 0
+        && !Nuzlocke_MonIsDead(mon);
+}
+
+// Puts a party Pokemon in the graveyard box (or any free box slot if the
+// graveyard is full) and removes it from the party.
+static void Nuzlocke_BuryPartyMon(SaveData *saveData, Party *party, int slot) {
+    PCStorage *pc = SaveArray_PCStorage_Get(saveData);
+    Pokemon *mon = Party_GetMonByIndex(party, slot);
+    BoxPokemon *boxMon = Mon_GetBoxMon(mon);
+
+    if (!PCStorage_PlaceMonInBoxFirstEmptySlot(pc, NUZLOCKE_GRAVEYARD_BOX, boxMon)) {
+        PCStorage_PlaceMonInFirstEmptySlotInAnyBox(pc, boxMon);
+    }
+    Party_RemoveMon(party, slot);
+}
+
+#define NUZLOCKE_NOT_WILD (BATTLE_TYPE_TRAINER | BATTLE_TYPE_LINK | BATTLE_TYPE_TUTORIAL | BATTLE_TYPE_PAL_PARK | BATTLE_TYPE_BUG_CONTEST | BATTLE_TYPE_FRONTIER | BATTLE_TYPE_DEBUG)
+
+void Nuzlocke_OnBattleEnd(BattleSetup *setup, FieldSystem *fieldSystem) {
+    u32 mapsec = MapHeader_GetMapSec(fieldSystem->location->mapId);
+    BOOL caught = setup->winFlag == BATTLE_OUTCOME_MON_CAUGHT;
+    BOOL wild = !(setup->battleType & NUZLOCKE_NOT_WILD);
+    u16 wildSpecies = wild ? GetMonData(Party_GetMonByIndex(setup->party[BATTLER_ENEMY], 0), MON_DATA_SPECIES, NULL) : SPECIES_NONE;
+    BOOL rules = Nuzlocke_UpdateRulesActive(fieldSystem->saveData);
+
+    sCatchBlocked = FALSE;
+
+    if (caught) {
+        sAutosaveRequested = TRUE; // a catch
+        if (sCaughtValid) {
+            sCaught.mapsec = mapsec;
+            Nuzlocke_AddEvent(NUZLOCKE_EVENT_CAUGHT, sCaughtToPC, &sCaught);
+        }
+    }
+    if (sLogPending) {
+        sAutosaveRequested = TRUE; // the area's first encounter
+        if (caught) {
+            Nuzlocke_SetLog(fieldSystem->saveData, sLogPendingMapsec, SPECIES_NONE, NUZLOCKE_LOG_CAUGHT);
+        } else {
+            NuzlockeDeath info;
+            MI_CpuClear8(&info, sizeof(info));
+            info.species = wildSpecies;
+            info.mapsec = sLogPendingMapsec;
+            info.level = GetMonData(Party_GetMonByIndex(setup->party[BATTLER_ENEMY], 0), MON_DATA_LEVEL, NULL);
+            Nuzlocke_AddEvent(NUZLOCKE_EVENT_FAILED, setup->winFlag, &info);
+        }
+        sLogPending = FALSE;
+    } else if (wild && rules && !(setup->battleType & BATTLE_TYPE_SAFARI)) {
+        // Encounters that don't use up an area go in the log as bonus entries.
+        if (sRandomEncounter && !(setup->battleType & BATTLE_TYPE_ROAMER)) {
+            if (sShinyEncounter && caught) {
+                Nuzlocke_AddBonusLog(fieldSystem->saveData, mapsec, wildSpecies, NUZLOCKE_LOG_SHINY);
+            }
+        } else if (caught) {
+            Nuzlocke_AddBonusLog(fieldSystem->saveData, mapsec, wildSpecies, NUZLOCKE_LOG_STATIC);
+        } else if (setup->winFlag == BATTLE_OUTCOME_WIN) {
+            Nuzlocke_AddBonusLog(fieldSystem->saveData, mapsec, wildSpecies, NUZLOCKE_LOG_STATIC_FAILED);
+            sAutosaveRequested = TRUE; // it's gone for good
+        }
+    } else if (sShinyEncounter && caught) {
+        Nuzlocke_AddBonusLog(fieldSystem->saveData, mapsec, wildSpecies, NUZLOCKE_LOG_SHINY);
+    }
+    sRandomEncounter = FALSE;
+    sShinyEncounter = FALSE;
+    sCaughtValid = FALSE;
+
+#if NUZLOCKE_PERMADEATH
+    SaveData *saveData = fieldSystem->saveData;
+    if (setup->battleType & (BATTLE_TYPE_LINK | BATTLE_TYPE_FRONTIER | BATTLE_TYPE_DEBUG)) {
+        return;
+    }
+    if (!Nuzlocke_UpdateRulesActive(saveData)) {
+        return;
+    }
+
+    NuzlockeSave *nz = Save_Nuzlocke_Get(saveData);
+    Party *party = SaveArray_Party_Get(saveData);
+    int count = Party_GetCount(party);
+    int alive = 0;
+    int i;
+
+    for (i = 0; i < count; i++) {
+        if (Nuzlocke_MonCanFight(Party_GetMonByIndex(party, i))) {
+            alive++;
+        }
+    }
+
+    if (alive == 0) {
+        // Wipeout: the run is over. Keep the final team in the party so it
+        // can be shown on the run-over screen, but count them as fallen.
+        for (i = 0; i < count; i++) {
+            Pokemon *mon = Party_GetMonByIndex(party, i);
+            if (GetMonData(mon, MON_DATA_SPECIES_EXISTS, NULL) && !GetMonData(mon, MON_DATA_IS_EGG, NULL) && !Nuzlocke_MonIsDead(mon)) {
+                if (nz->deaths < 0xFFFF) {
+                    nz->deaths++;
+                }
+                Nuzlocke_RecordDeath(saveData, mon, mapsec);
+            }
+        }
+#if NUZLOCKE_WIPEOUT_ENDS
+        nz->runOver = TRUE;
+#endif
+        return;
+    }
+
+    for (i = count - 1; i >= 0; i--) {
+        Pokemon *mon = Party_GetMonByIndex(party, i);
+        if (!GetMonData(mon, MON_DATA_SPECIES_EXISTS, NULL) || GetMonData(mon, MON_DATA_IS_EGG, NULL)) {
+            continue;
+        }
+        if (GetMonData(mon, MON_DATA_HP, NULL) == 0) {
+            u8 dead = TRUE;
+            Nuzlocke_RecordDeath(saveData, mon, mapsec);
+            SetMonData(mon, NUZLOCKE_DEAD_MARKER, &dead);
+            if (nz->deaths < 0xFFFF) {
+                nz->deaths++;
+            }
+            Nuzlocke_BuryPartyMon(saveData, party, i);
+            sAutosaveRequested = TRUE; // a death
+        }
+    }
+
+    Nuzlocke_CheckVictory(setup, saveData);
+#endif
+}
+
+void Nuzlocke_FillRecord(SaveData *saveData, NuzlockeRecord *record) {
+    PlayerProfile *profile = Save_PlayerData_GetProfile(saveData);
+    IGT *igt = Save_PlayerData_GetIGTAddr(saveData);
+    Party *party = SaveArray_Party_Get(saveData);
+    int i;
+
+    MI_CpuClear8(record, sizeof(NuzlockeRecord));
+    record->valid = TRUE;
+    record->badges = PlayerProfile_CountBadges(profile);
+    record->deaths = Save_Nuzlocke_Get(saveData)->deaths;
+    record->hours = GetIGTHours(igt);
+    record->minutes = GetIGTMinutes(igt);
+    record->caught = Pokedex_CountDexOwned(Save_Pokedex_Get(saveData));
+    for (i = 0; i < Party_GetCount(party) && record->teamCount < PARTY_SIZE; i++) {
+        Pokemon *mon = Party_GetMonByIndex(party, i);
+        NuzlockeTeamMon *dest;
+        if (!GetMonData(mon, MON_DATA_SPECIES_EXISTS, NULL) || GetMonData(mon, MON_DATA_IS_EGG, NULL)) {
+            continue;
+        }
+        dest = &record->team[record->teamCount++];
+        dest->species = GetMonData(mon, MON_DATA_SPECIES, NULL);
+        dest->level = GetMonData(mon, MON_DATA_LEVEL, NULL);
+        dest->form = GetMonData(mon, MON_DATA_FORM, NULL);
+        GetMonData(mon, MON_DATA_NICKNAME, dest->nickname);
+    }
+}
+
+int Nuzlocke_TakePendingVictory(void) {
+    int ret = sPendingVictory;
+    sPendingVictory = -1;
+    return ret;
+}
+
+static void Nuzlocke_CheckVictory(BattleSetup *setup, SaveData *saveData) {
+#if NUZLOCKE_VICTORY_SCREENS
+    NuzlockeSave *nz = Save_Nuzlocke_Get(saveData);
+    int trainerId = setup->trainerId[BATTLER_ENEMY];
+    int record;
+
+    if (!(setup->battleType & BATTLE_TYPE_TRAINER) || setup->winFlag != BATTLE_OUTCOME_WIN || nz->runOver) {
+        return;
+    }
+    if (trainerId == TRAINER_CHAMPION_LANCE || trainerId == TRAINER_CHAMPION_LANCE_2 || trainerId == TRAINER_CHAMPION_LANCE_3) {
+        record = NUZLOCKE_RECORD_CHAMPION;
+    } else if (trainerId == TRAINER_PKMN_TRAINER_RED_RED) {
+        record = NUZLOCKE_RECORD_RED;
+    } else {
+        return;
+    }
+    if (nz->records[record].valid && !sTestMode) {
+        return; // only the first win is recorded (test mode always shows it)
+    }
+    // Snapshot the winning team (after any deaths in the final battle).
+    Nuzlocke_FillRecord(saveData, &nz->records[record]);
+    sPendingVictory = record;
+    Nuzlocke_AddEvent(NUZLOCKE_EVENT_VICTORY, record, NULL);
+    sAutosaveRequested = TRUE; // a victory
+#endif
+}
+
+// Called when the player closes the PC. Dead Pokemon can't leave the PC:
+// any that were withdrawn go straight back to the graveyard.
+void Nuzlocke_OnPCClosed(SaveData *saveData) {
+#if NUZLOCKE_PERMADEATH
+    Party *party = SaveArray_Party_Get(saveData);
+    PCStorage *pc = SaveArray_PCStorage_Get(saveData);
+    int i;
+    int box, slot;
+    BOOL hasFighter = FALSE;
+
+    if (!Nuzlocke_UpdateRulesActive(saveData)) {
+        return;
+    }
+
+    for (i = 0; i < Party_GetCount(party); i++) {
+        Pokemon *mon = Party_GetMonByIndex(party, i);
+        if (Nuzlocke_MonCanFight(mon)) {
+            hasFighter = TRUE;
+        }
+    }
+
+    if (!hasFighter) {
+        // The player left only dead Pokemon (or Eggs) in the party. Bring
+        // back the first living Pokemon from the PC so the game can continue.
+        Pokemon *tmp = AllocMonZeroed(HEAP_ID_FIELD2);
+        for (box = 0; box < NUM_BOXES && !hasFighter; box++) {
+            for (slot = 0; slot < MONS_PER_BOX && !hasFighter; slot++) {
+                BoxPokemon *boxMon = PCStorage_GetMonByIndexPair(pc, box, slot);
+                if (!GetBoxMonData(boxMon, MON_DATA_SPECIES_EXISTS, NULL) || GetBoxMonData(boxMon, MON_DATA_IS_EGG, NULL) || GetBoxMonData(boxMon, NUZLOCKE_DEAD_MARKER, NULL)) {
+                    continue;
+                }
+                CopyBoxPokemonToPokemon(boxMon, tmp);
+                if (Party_GetCount(party) >= PARTY_SIZE) {
+                    // Make room by burying a dead party member first.
+                    for (i = Party_GetCount(party) - 1; i >= 0; i--) {
+                        if (Nuzlocke_MonIsDead(Party_GetMonByIndex(party, i))) {
+                            Nuzlocke_BuryPartyMon(saveData, party, i);
+                            break;
+                        }
+                    }
+                }
+                if (Party_AddMon(party, tmp)) {
+                    PCStorage_DeleteBoxMonByIndexPair(pc, box, slot);
+                    hasFighter = TRUE;
+                }
+            }
+        }
+        Heap_Free(tmp);
+    }
+
+    if (!hasFighter) {
+        // Nothing alive anywhere. Leave the party alone; the next battle
+        // will end the run.
+        return;
+    }
+
+    for (i = Party_GetCount(party) - 1; i >= 0; i--) {
+        if (Nuzlocke_MonIsDead(Party_GetMonByIndex(party, i))) {
+            Nuzlocke_BuryPartyMon(saveData, party, i);
+        }
+    }
+#endif
+}
+
+// ------------------------------------------------------------------
+// Test mode
+// ------------------------------------------------------------------
+
+BOOL Nuzlocke_IsTestMode(void) {
+    return sTestMode;
+}
+
+static u32 sTestTrainer;
+static u32 sTestWinFlag;
+
+static BOOL Task_NuzlockeTestBattle(TaskManager *taskManager) {
+    u32 *state = TaskManager_GetStatePtr(taskManager);
+    if (*state == 0) {
+        SetupAndStartTrainerBattle(taskManager, sTestTrainer, 0, 0, 0, 0, HEAP_ID_FIELD2, &sTestWinFlag);
+        (*state)++;
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static void Nuzlocke_GiveTestTeam(FieldSystem *fieldSystem) {
+    static const u16 species[PARTY_SIZE] = { SPECIES_LUGIA, SPECIES_DRAGONITE, SPECIES_TYRANITAR, SPECIES_TYPHLOSION, SPECIES_GENGAR, SPECIES_PIKACHU };
+    SaveData *saveData = fieldSystem->saveData;
+    Party *party = SaveArray_Party_Get(saveData);
+    PlayerProfile *profile = Save_PlayerData_GetProfile(saveData);
+    u32 mapsec = MapHeader_GetMapSec(fieldSystem->location->mapId);
+    int i;
+
+    if (Party_GetCount(party) < PARTY_SIZE) {
+        Pokemon *mon = AllocMonZeroed(HEAP_ID_FIELD2);
+        for (i = Party_GetCount(party); i < PARTY_SIZE; i++) {
+            ZeroMonData(mon);
+            CreateMon(mon, species[i], 100, 31, FALSE, 0, OT_ID_PLAYER_ID, 0);
+            sub_020720FC(mon, profile, ITEM_POKE_BALL, mapsec, 12, HEAP_ID_FIELD2);
+            Party_AddMon(party, mon);
+        }
+        Heap_Free(mon);
+    }
+    // Put a level 100 Pokemon in front.
+    for (i = 1; i < Party_GetCount(party); i++) {
+        if (GetMonData(Party_GetMonByIndex(party, 0), MON_DATA_LEVEL, NULL) >= 100) {
+            break;
+        }
+        Party_SwapSlots(party, 0, i);
+    }
+    // Poke Balls switch the Nuzlocke rules on.
+    if (!Bag_HasItem(Save_Bag_Get(saveData), ITEM_POKE_BALL, 1, HEAP_ID_FIELD2)) {
+        Bag_AddItem(Save_Bag_Get(saveData), ITEM_POKE_BALL, 10, HEAP_ID_FIELD2);
+    }
+}
+
+void Nuzlocke_StartTestBattle(FieldSystem *fieldSystem, BOOL red) {
+    // From here until power-off, nothing is written to the save file
+    // (see FlashWriteChunkInternal in save.c).
+    sTestMode = TRUE;
+    Nuzlocke_GiveTestTeam(fieldSystem);
+    sTestTrainer = red ? TRAINER_PKMN_TRAINER_RED_RED : TRAINER_CHAMPION_LANCE;
+    FieldSystem_CreateTask(fieldSystem, Task_NuzlockeTestBattle, NULL);
+}
diff --git a/src/nuzlocke_battle.c b/src/nuzlocke_battle.c
new file mode 100644
index 0000000..35bd608
--- /dev/null
+++ b/src/nuzlocke_battle.c
@@ -0,0 +1,257 @@
+#include "nuzlocke.h"
+
+#include "global.h"
+
+#include "constants/battle.h"
+#include "constants/battle_subscript.h"
+
+#include "battle/battle.h"
+#include "battle/battle_system.h"
+#include "filesystem_files_def.h"
+#include "nuzlocke_battle.h"
+
+// ------------------------------------------------------------------
+// Death causes.
+//
+// The battle engine runs scripts from NARCs and can call into
+// "subscripts" (up to 4 deep). Every source of damage ends up in the
+// UPDATE_HP subscript, so the cause of a faint is whichever script
+// called into it: the move script for a normal hit, the poison
+// subscript for poison damage, the weather subscript for sandstorm, etc.
+//
+// For each depth of the script stack we remember the script that was
+// entered there. Jumps (not calls) into UPDATE_HP keep the old entry
+// so that "poison -> goto UPDATE_HP" still counts as poison.
+// ------------------------------------------------------------------
+
+#define ORIGIN_MOVE 0xFFFF // a move or move-effect script
+#define ORIGIN_DEPTH 5
+
+static u16 sOrigin[ORIGIN_DEPTH];
+
+typedef struct NuzlockeFaint {
+    u32 personality;
+    u16 foeSpecies;
+    u16 trainerId;
+    u16 move;
+    u8 cause;
+    u8 used;
+} NuzlockeFaint;
+
+static NuzlockeFaint sFaints[PARTY_SIZE * 2];
+
+void Nuzlocke_BattleReset(void) {
+    MI_CpuClear8(sFaints, sizeof(sFaints));
+    MI_CpuClear8(sOrigin, sizeof(sOrigin));
+}
+
+void Nuzlocke_BattleScriptLoaded(int depth, int narcId, int fileId, BOOL isCall) {
+    u16 origin;
+    if (depth < 0 || depth >= ORIGIN_DEPTH) {
+        return;
+    }
+    origin = (narcId == NARC_a_0_0_1) ? fileId : ORIGIN_MOVE;
+    if (!isCall && origin == BATTLE_SUBSCRIPT_UPDATE_HP) {
+        return; // tail jump into the HP update: keep whoever jumped here
+    }
+    sOrigin[depth] = origin;
+}
+
+// Scripts that don't say anything about where the damage came from.
+static BOOL Nuzlocke_IsNeutralScript(u16 origin) {
+    switch (origin) {
+    case BATTLE_SUBSCRIPT_UPDATE_HP:
+    case BATTLE_SUBSCRIPT_FAINT_MON:
+    case BATTLE_SUBSCRIPT_CRITICAL_HIT:
+    case BATTLE_SUBSCRIPT_TYPE_RESIST_BERRY:
+    case BATTLE_SUBSCRIPT_WAIT_MOVE_ANIMATION:
+    case BATTLE_SUBSCRIPT_ATTACK_MESSAGE_AND_ANIMATION:
+    case BATTLE_SUBSCRIPT_SHOW_PREPARED_MESSAGE:
+    case BATTLE_SUBSCRIPT_PUSH_ATTACKER_AND_DEFENDER:
+    case BATTLE_SUBSCRIPT_POP_ATTACKER_AND_DEFENDER:
+    case BATTLE_SUBSCRIPT_HIT_X_TIMES:
+    case BATTLE_SUBSCRIPT_MOVE_FOLLOWUP_MESSAGE:
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static u8 Nuzlocke_CauseFromScript(u16 origin, BOOL *usesFoe) {
+    *usesFoe = FALSE;
+    switch (origin) {
+    case BATTLE_SUBSCRIPT_POISON_DAMAGE:
+        return NUZLOCKE_CAUSE_POISON;
+    case BATTLE_SUBSCRIPT_BURN_DAMAGE:
+        return NUZLOCKE_CAUSE_BURN;
+    case BATTLE_SUBSCRIPT_WEATHER_CONTINUES:
+        return NUZLOCKE_CAUSE_WEATHER; // refined below
+    case BATTLE_SUBSCRIPT_HURT_SELF_IN_CONFUSION:
+        return NUZLOCKE_CAUSE_CONFUSION;
+    case BATTLE_SUBSCRIPT_DISOBEY_HIT_SELF:
+        return NUZLOCKE_CAUSE_DISOBEY;
+    case BATTLE_SUBSCRIPT_RECOIL_1_4:
+    case BATTLE_SUBSCRIPT_RECOIL_1_3:
+    case BATTLE_SUBSCRIPT_RECOIL_1_2:
+    case BATTLE_SUBSCRIPT_RECOIL_1_3_CHANCE_TO_BURN:
+    case BATTLE_SUBSCRIPT_RECOIL_1_3_CHANCE_TO_PARALYZE:
+    case BATTLE_SUBSCRIPT_STRUGGLE:
+        return NUZLOCKE_CAUSE_RECOIL;
+    case BATTLE_SUBSCRIPT_CRASH_ON_MISS:
+        return NUZLOCKE_CAUSE_CRASH;
+    case BATTLE_SUBSCRIPT_CURSE_DAMAGE:
+    case BATTLE_SUBSCRIPT_CURSE_GHOST:
+        return NUZLOCKE_CAUSE_CURSE;
+    case BATTLE_SUBSCRIPT_NIGHTMARE_EFFECT:
+        return NUZLOCKE_CAUSE_NIGHTMARE;
+    case BATTLE_SUBSCRIPT_BIND_EFFECT:
+        return NUZLOCKE_CAUSE_BIND;
+    case BATTLE_SUBSCRIPT_LEECH_SEED_EFFECT:
+        return NUZLOCKE_CAUSE_LEECH_SEED;
+    case BATTLE_SUBSCRIPT_CONTINUE_PERISH_SONG:
+        return NUZLOCKE_CAUSE_PERISH_SONG;
+    case BATTLE_SUBSCRIPT_HAZARDS_CHECK:
+        return NUZLOCKE_CAUSE_HAZARDS;
+    case BATTLE_SUBSCRIPT_ROUGH_SKIN:
+        *usesFoe = TRUE;
+        return NUZLOCKE_CAUSE_ROUGH_SKIN;
+    case BATTLE_SUBSCRIPT_AFTERMATH:
+        *usesFoe = TRUE;
+        return NUZLOCKE_CAUSE_AFTERMATH;
+    case BATTLE_SUBSCRIPT_BAD_DREAMS:
+        return NUZLOCKE_CAUSE_BAD_DREAMS;
+    case BATTLE_SUBSCRIPT_LOSE_HP_FROM_ITEM:
+    case BATTLE_SUBSCRIPT_LOSE_HP_FROM_ITEM_WITH_MESSAGE:
+        return NUZLOCKE_CAUSE_ITEM;
+    case BATTLE_SUBSCRIPT_HELD_ITEM_RECOIL_WHEN_HIT:
+        *usesFoe = TRUE;
+        return NUZLOCKE_CAUSE_FOE_ITEM;
+    case BATTLE_SUBSCRIPT_DESTINY_BOND:
+    case BATTLE_SUBSCRIPT_FAINT_CHECK_DESTINY_BOND:
+        *usesFoe = TRUE;
+        return NUZLOCKE_CAUSE_DESTINY_BOND;
+    case BATTLE_SUBSCRIPT_FUTURE_SIGHT_DAMAGE:
+        return NUZLOCKE_CAUSE_FUTURE_SIGHT;
+    case BATTLE_SUBSCRIPT_MEMENTO:
+    case BATTLE_SUBSCRIPT_HEALING_WISH:
+    case BATTLE_SUBSCRIPT_LUNAR_DANCE:
+    case BATTLE_SUBSCRIPT_PURSUIT:
+    case BATTLE_SUBSCRIPT_ATTACK_THEN_SWITCH_OUT:
+    case ORIGIN_MOVE:
+        return NUZLOCKE_CAUSE_MOVE;
+    }
+    return NUZLOCKE_CAUSE_UNKNOWN;
+}
+
+static NuzlockeFaint *Nuzlocke_FaintSlot(u32 personality) {
+    int i;
+    for (i = 0; i < (int)NELEMS(sFaints); i++) {
+        if (sFaints[i].used && sFaints[i].personality == personality) {
+            return &sFaints[i];
+        }
+    }
+    for (i = 0; i < (int)NELEMS(sFaints); i++) {
+        if (!sFaints[i].used) {
+            return &sFaints[i];
+        }
+    }
+    return NULL;
+}
+
+static void Nuzlocke_SetFoe(BattleSystem *battleSystem, BattleContext *ctx, NuzlockeFaint *faint, int foe) {
+    if (foe < 0 || foe >= 4) {
+        return;
+    }
+    faint->foeSpecies = ctx->battleMons[foe].species;
+    if (battleSystem->battleType & BATTLE_TYPE_TRAINER) {
+        faint->trainerId = battleSystem->trainerId[foe];
+    }
+}
+
+// Called right after a battler's HP changes. Records how a player
+// Pokemon was knocked out.
+void Nuzlocke_OnBattlerHPChanged(BattleSystem *battleSystem, BattleContext *ctx, int battlerId, int oldHp) {
+    NuzlockeFaint *faint;
+    BOOL usesFoe;
+    u8 cause = NUZLOCKE_CAUSE_UNKNOWN;
+    int depth;
+    int attacker = ctx->battlerIdAttacker;
+
+    if (oldHp <= 0 || ctx->battleMons[battlerId].hp != 0) {
+        return;
+    }
+    if (BattleSystem_GetFieldSide(battleSystem, battlerId) != 0) {
+        return; // only the player's side
+    }
+
+    // The innermost script that says where the damage came from. Scripts
+    // that don't (messages, animations...) are skipped; if none does, the
+    // damage came from the move being used.
+    cause = NUZLOCKE_CAUSE_MOVE;
+    usesFoe = FALSE;
+    for (depth = ctx->unk_B8; depth >= 0; depth--) {
+        if (depth < ORIGIN_DEPTH && !Nuzlocke_IsNeutralScript(sOrigin[depth])) {
+            BOOL foe;
+            u8 c = Nuzlocke_CauseFromScript(sOrigin[depth], &foe);
+            if (c != NUZLOCKE_CAUSE_UNKNOWN) {
+                cause = c;
+                usesFoe = foe;
+                break;
+            }
+        }
+    }
+
+    faint = Nuzlocke_FaintSlot(ctx->battleMons[battlerId].personality);
+    if (faint == NULL) {
+        return;
+    }
+    MI_CpuClear8(faint, sizeof(NuzlockeFaint));
+    faint->used = TRUE;
+    faint->personality = ctx->battleMons[battlerId].personality;
+    faint->move = ctx->moveNoCur;
+
+    switch (cause) {
+    case NUZLOCKE_CAUSE_MOVE:
+        if (attacker == battlerId) {
+            cause = NUZLOCKE_CAUSE_SELF_MOVE; // Explosion, Selfdestruct, Memento...
+        } else if (BattleSystem_GetFieldSide(battleSystem, attacker) == 0) {
+            cause = NUZLOCKE_CAUSE_ALLY_MOVE;
+        } else {
+            Nuzlocke_SetFoe(battleSystem, ctx, faint, attacker);
+        }
+        break;
+    case NUZLOCKE_CAUSE_WEATHER:
+        if (ctx->fieldCondition & FIELD_CONDITION_SANDSTORM_ALL) {
+            cause = NUZLOCKE_CAUSE_SANDSTORM;
+        } else if (ctx->fieldCondition & FIELD_CONDITION_HAIL_ALL) {
+            cause = NUZLOCKE_CAUSE_HAIL;
+        } else {
+            cause = NUZLOCKE_CAUSE_OWN_ABILITY; // Dry Skin / Solar Power
+        }
+        break;
+    case NUZLOCKE_CAUSE_RECOIL:
+    case NUZLOCKE_CAUSE_CRASH:
+        break;
+    default:
+        if (usesFoe) {
+            // The fainted Pokemon was the one using the move; its target
+            // owned the ability / item / Destiny Bond.
+            Nuzlocke_SetFoe(battleSystem, ctx, faint, attacker == battlerId ? ctx->battlerIdTarget : attacker);
+        }
+        break;
+    }
+    faint->cause = cause;
+}
+
+BOOL Nuzlocke_GetFaintCause(u32 personality, u8 *cause, u16 *foeSpecies, u16 *trainerId, u16 *move) {
+    int i;
+    for (i = 0; i < (int)NELEMS(sFaints); i++) {
+        if (sFaints[i].used && sFaints[i].personality == personality) {
+            *cause = sFaints[i].cause;
+            *foeSpecies = sFaints[i].foeSpecies;
+            *trainerId = sFaints[i].trainerId;
+            *move = sFaints[i].move;
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
diff --git a/src/nuzlocke_screen.c b/src/nuzlocke_screen.c
new file mode 100644
index 0000000..d63714a
--- /dev/null
+++ b/src/nuzlocke_screen.c
@@ -0,0 +1,1071 @@
+// ------------------------------------------------------------------
+// Nuzlocke screens: run over, victory (Champion / Red) and the
+// records viewer (SELECT in the overworld).
+//
+// Everything is drawn on main BG2 as plain windows. Pokemon party icons
+// are 32x32 4bpp images stored in the same tile order as a 4x4-tile
+// window, so they are copied straight into small windows that use the
+// icon palettes.
+// ------------------------------------------------------------------
+#include "global.h"
+
+#include "constants/sndseq.h"
+
+#include "msgdata/msg.naix"
+#include "msgdata/msg/msg_0203.h"
+
+#include "bg_window.h"
+#include "brightness.h"
+#include "field_bgm.h"
+#include "field_system.h"
+#include "filesystem_files_def.h"
+#include "font.h"
+#include "gf_gfx_loader.h"
+#include "gf_gfx_planes.h"
+#include "heap.h"
+#include "igt.h"
+#include "map_object.h"
+#include "message_format.h"
+#include "msgdata.h"
+#include "nuzlocke.h"
+#include "party.h"
+#include "player_data.h"
+#include "pm_string.h"
+#include "pokemon.h"
+#include "pokemon_icon_idx.h"
+#include "save.h"
+#include "save_arrays.h"
+#include "screen_fade.h"
+#include "sound.h"
+#include "system.h"
+#include "constants/battle.h"
+#include "constants/species.h"
+#include "constants/trainer_class.h"
+#include "save_misc_data.h"
+#include "text.h"
+#include "trainer_data.h"
+#include "unk_0200B150.h"
+#include "unk_02005D10.h"
+#include "unk_02055244.h"
+#include "unk_020552A4.h"
+#include "use_item_on_mon.h"
+
+#define NZ_LAYER GF_BG_LYR_MAIN_2
+
+// Palette slots
+#define NZ_PLTT_ICON_BASE 8  // 8..11: party icon palettes
+#define NZ_PLTT_UI        14 // UI colors below
+
+// UI palette color indices
+enum {
+    NZC_CLEAR = 0,
+    NZC_WHITE,
+    NZC_SHADOW,
+    NZC_RED,
+    NZC_GOLD,
+    NZC_BLUE,
+    NZC_PANEL,
+    NZC_GREY,
+    NZC_GOLD_TEXT,
+    NZC_RED_TEXT,
+    NZC_DARK,
+    NZC_GREEN,
+    NZC_GREEN_TEXT,
+    NZC_MEMORIAL,
+};
+
+static const u16 sUiPalette[16] = {
+    [NZC_CLEAR] = RGB(2, 3, 7),
+    [NZC_WHITE] = RGB(31, 31, 31),
+    [NZC_SHADOW] = RGB(4, 4, 6),
+    [NZC_RED] = RGB(20, 3, 4),
+    [NZC_GOLD] = RGB(24, 17, 2),
+    [NZC_BLUE] = RGB(4, 9, 21),
+    [NZC_PANEL] = RGB(6, 8, 14),
+    [NZC_GREY] = RGB(22, 23, 26),
+    [NZC_GOLD_TEXT] = RGB(31, 26, 8),
+    [NZC_RED_TEXT] = RGB(31, 14, 14),
+    [NZC_DARK] = RGB(1, 1, 3),
+    [NZC_GREEN] = RGB(3, 14, 6),
+    [NZC_GREEN_TEXT] = RGB(12, 30, 12),
+    [NZC_MEMORIAL] = RGB(9, 7, 13),
+};
+
+#define NZ_BACKDROP RGB(2, 3, 7)
+
+static const struct GraphicsBanks sNzGraphicsBanks = {
+    .bg = GX_VRAM_BG_128_B,
+    .bgextpltt = GX_VRAM_BGEXTPLTT_NONE,
+    .subbg = GX_VRAM_SUB_BG_128_C,
+    .subbgextpltt = GX_VRAM_SUB_BGEXTPLTT_NONE,
+    .obj = GX_VRAM_OBJ_64_E,
+    .objextpltt = GX_VRAM_OBJEXTPLTT_NONE,
+    .subobj = GX_VRAM_SUB_OBJ_16_I,
+    .subobjextpltt = GX_VRAM_SUB_OBJEXTPLTT_NONE,
+    .tex = GX_VRAM_TEX_0_A,
+    .texpltt = GX_VRAM_TEXPLTT_01_FG,
+};
+
+static const struct GraphicsModes sNzGraphicsModes = {
+    .dispMode = GX_DISPMODE_GRAPHICS,
+    .bgMode = GX_BGMODE_0,
+    .subMode = GX_BGMODE_0,
+    ._2d3dMode = GX_BG0_AS_2D,
+};
+
+static const BgTemplate sNzBgTemplate = {
+    .x = 0,
+    .y = 0,
+    .bufferSize = 0x800,
+    .baseTile = 0,
+    .size = GF_BG_SCR_SIZE_256x256,
+    .colorMode = GX_BG_COLORMODE_16,
+    .screenBase = GX_BG_SCRBASE_0xf800,
+    .charBase = GX_BG_CHARBASE_0x00000,
+    .bgExtPltt = GX_BG_EXTPLTT_01,
+    .priority = 1,
+    .areaOver = GX_BG_AREAOVER_XLU,
+    .dummy = 0,
+    .mosaic = FALSE
+};
+
+// Layout (in 8x8 tiles)
+#define BANNER_Y      0
+#define BANNER_H      3
+#define INFO_Y        3
+#define INFO_H        4
+#define CARD_W        10
+#define CARD_ICON_Y   7
+#define CARD_PLATE_H  4
+#define CARD_ROW_STEP 8
+
+// List layout (memorial and saving panel): 4 rows of icon + 3 text lines
+#define LIST_Y        3
+#define LIST_ROWS     4
+#define LIST_ROW_H    5
+#define LIST_TEXT_X   5
+#define LIST_TEXT_W   26
+#define LIST_LINE_1   0
+#define LIST_LINE_2   12
+#define LIST_LINE_3   24
+
+enum {
+    NZ_LAYOUT_NONE,
+    NZ_LAYOUT_CARDS,
+    NZ_LAYOUT_LIST,
+};
+
+enum {
+    WIN_BANNER,
+    WIN_INFO,
+    WIN_ICON_FIRST,
+    WIN_PLATE_FIRST = WIN_ICON_FIRST + PARTY_SIZE,
+    WIN_COUNT = WIN_PLATE_FIRST + PARTY_SIZE,
+};
+
+enum {
+    NZ_MODE_RUN_OVER, // never closes
+    NZ_MODE_VICTORY,  // one page, A closes
+    NZ_MODE_RECORDS,  // A = next page, B = close
+    NZ_MODE_SAVING,   // saves while shown, then closes by itself
+};
+
+enum {
+    NZ_PAGE_RUN_OVER,
+    NZ_PAGE_LIVE,
+    NZ_PAGE_CHAMPION,
+    NZ_PAGE_RED,
+    NZ_PAGE_LOG,
+    NZ_PAGE_MEMORIAL,
+    NZ_PAGE_SAVING,
+};
+
+#define NZ_MAX_PAGES (3 + (NUZLOCKE_LOG_MAX + PARTY_SIZE - 1) / PARTY_SIZE + (NUZLOCKE_DEATHS_MAX + LIST_ROWS - 1) / LIST_ROWS)
+
+typedef struct NuzlockeScreen {
+    u8 mode;
+    u8 page;
+    u8 numPages;
+    u8 pages[NZ_MAX_PAGES];
+    u8 pageArg[NZ_MAX_PAGES];
+    u8 displayReady;
+    u8 layout;
+    u16 timer;
+    BgConfig *bgConfig;
+    MsgData *msgData;
+    MessageFormat *msgFmt;
+    void *iconPlttRaw;
+    NNSG2dPaletteData *iconPltt;
+    // Display state to put back when the screen closes (the overworld
+    // reload after a battle relies on it).
+    GraphicsBanks savedBanks;
+    u32 savedDispA;
+    u16 savedBg2Cnt;
+    u16 savedBackdrop;
+    Window windows[WIN_COUNT];
+    NuzlockeRecord live;
+} NuzlockeScreen;
+
+static NuzlockeScreen *NuzScreen_New(int mode) {
+    NuzlockeScreen *scr = Heap_Alloc(HEAP_ID_FIELD2, sizeof(NuzlockeScreen));
+    GF_ASSERT(scr != NULL);
+    MI_CpuClear8(scr, sizeof(NuzlockeScreen));
+    scr->mode = mode;
+    return scr;
+}
+
+static void NuzScreen_AddRecordPages(NuzlockeScreen *scr, SaveData *saveData) {
+    NuzlockeSave *nz = Save_Nuzlocke_Get(saveData);
+    int logCount = Nuzlocke_GetLogCount(saveData);
+    int i;
+    int deathCount = Nuzlocke_GetDeathRecordCount(saveData);
+    for (i = 0; i * PARTY_SIZE < logCount; i++) {
+        scr->pageArg[scr->numPages] = i;
+        scr->pages[scr->numPages++] = NZ_PAGE_LOG;
+    }
+    for (i = 0; i * LIST_ROWS < deathCount; i++) {
+        scr->pageArg[scr->numPages] = i;
+        scr->pages[scr->numPages++] = NZ_PAGE_MEMORIAL;
+    }
+    if (nz->records[NUZLOCKE_RECORD_CHAMPION].valid) {
+        scr->pages[scr->numPages++] = NZ_PAGE_CHAMPION;
+    }
+    if (nz->records[NUZLOCKE_RECORD_RED].valid) {
+        scr->pages[scr->numPages++] = NZ_PAGE_RED;
+    }
+}
+
+// ---------------------------------------------------------------- drawing
+
+static void NuzScreen_InitDisplay(NuzlockeScreen *scr) {
+    scr->savedBanks.bg = GX_GetBankForBG();
+    scr->savedBanks.bgextpltt = GX_GetBankForBGExtPltt();
+    scr->savedBanks.subbg = GX_GetBankForSubBG();
+    scr->savedBanks.subbgextpltt = GX_GetBankForSubBGExtPltt();
+    scr->savedBanks.obj = GX_GetBankForOBJ();
+    scr->savedBanks.objextpltt = GX_GetBankForOBJExtPltt();
+    scr->savedBanks.subobj = GX_GetBankForSubOBJ();
+    scr->savedBanks.subobjextpltt = GX_GetBankForSubOBJExtPltt();
+    scr->savedBanks.tex = GX_GetBankForTex();
+    scr->savedBanks.texpltt = GX_GetBankForTexPltt();
+    scr->savedDispA = reg_GX_DISPCNT;
+    scr->savedBg2Cnt = reg_G2_BG2CNT;
+    scr->savedBackdrop = *(vu16 *)HW_BG_PLTT;
+
+    scr->bgConfig = BgConfig_Alloc(HEAP_ID_FIELD2);
+    // Only the top screen is changed; the bottom screen is left alone.
+    GraphicsBanks banks = sNzGraphicsBanks;
+    banks.subbg = scr->savedBanks.subbg;
+    banks.subbgextpltt = scr->savedBanks.subbgextpltt;
+    banks.subobj = scr->savedBanks.subobj;
+    banks.subobjextpltt = scr->savedBanks.subobjextpltt;
+    sub_0200FBF4(PM_LCD_TOP, RGB_BLACK);
+    ResetVisibleHardwareWindows(PM_LCD_TOP);
+    GfGfx_SetBanks(&banks);
+    SetScreenModeAndDisable(&sNzGraphicsModes, SCREEN_MAIN);
+    InitBgFromTemplate(scr->bgConfig, NZ_LAYER, &sNzBgTemplate, GF_BG_TYPE_TEXT);
+    BgClearTilemapBufferAndCommit(scr->bgConfig, NZ_LAYER);
+    BgSetPosTextAndCommit(scr->bgConfig, NZ_LAYER, BG_POS_OP_SET_X, 0);
+    BgSetPosTextAndCommit(scr->bgConfig, NZ_LAYER, BG_POS_OP_SET_Y, 0);
+
+    DC_FlushRange((void *)sUiPalette, sizeof(sUiPalette));
+    GX_LoadBGPltt(sUiPalette, NZ_PLTT_UI * 0x20, 0x20);
+    scr->iconPlttRaw = GfGfxLoader_GetPlttData(NARC_poketool_icongra_poke_icon, sub_02074490(), &scr->iconPltt, HEAP_ID_FIELD2);
+    DC_FlushRange(scr->iconPltt->pRawData, 0x80);
+    GX_LoadBGPltt(scr->iconPltt->pRawData, NZ_PLTT_ICON_BASE * 0x20, 0x80);
+    BG_SetMaskColor(NZ_LAYER, NZ_BACKDROP);
+
+    scr->msgData = NewMsgDataFromNarc(MSGDATA_LOAD_LAZY, NARC_msgdata_msg, msg_0203, HEAP_ID_FIELD2);
+    scr->msgFmt = MessageFormat_New(HEAP_ID_FIELD2);
+
+    scr->layout = NZ_LAYOUT_NONE;
+    scr->displayReady = TRUE;
+}
+
+static void NuzScreen_RemoveWindows(NuzlockeScreen *scr) {
+    int i;
+    for (i = 0; i < WIN_COUNT; i++) {
+        if (scr->windows[i].pixelBuffer != NULL) {
+            RemoveWindow(&scr->windows[i]);
+        }
+    }
+}
+
+// The card layout (team / log) and the list layout (memorial / saving)
+// don't fit in VRAM together, so the windows are rebuilt on a change.
+static void NuzScreen_SetLayout(NuzlockeScreen *scr, int layout) {
+    u16 baseTile = 1;
+    int i;
+
+    if (scr->layout == layout) {
+        return;
+    }
+    NuzScreen_RemoveWindows(scr);
+    BgClearTilemapBufferAndCommit(scr->bgConfig, NZ_LAYER);
+    scr->layout = layout;
+
+    AddWindowParameterized(scr->bgConfig, &scr->windows[WIN_BANNER], NZ_LAYER, 0, BANNER_Y, 32, BANNER_H, NZ_PLTT_UI, baseTile);
+    baseTile += 32 * BANNER_H;
+    if (layout == NZ_LAYOUT_CARDS) {
+        AddWindowParameterized(scr->bgConfig, &scr->windows[WIN_INFO], NZ_LAYER, 0, INFO_Y, 32, INFO_H, NZ_PLTT_UI, baseTile);
+        baseTile += 32 * INFO_H;
+        for (i = 0; i < PARTY_SIZE; i++) {
+            u8 cardX = 1 + (i % 3) * CARD_W;
+            u8 cardY = CARD_ICON_Y + (i / 3) * CARD_ROW_STEP;
+            AddWindowParameterized(scr->bgConfig, &scr->windows[WIN_ICON_FIRST + i], NZ_LAYER, cardX + 3, cardY, 4, 4, NZ_PLTT_ICON_BASE, baseTile);
+            baseTile += 16;
+            AddWindowParameterized(scr->bgConfig, &scr->windows[WIN_PLATE_FIRST + i], NZ_LAYER, cardX, cardY + 4, CARD_W, CARD_PLATE_H, NZ_PLTT_UI, baseTile);
+            baseTile += CARD_W * CARD_PLATE_H;
+        }
+    } else {
+        for (i = 0; i < LIST_ROWS; i++) {
+            u8 rowY = LIST_Y + i * LIST_ROW_H;
+            AddWindowParameterized(scr->bgConfig, &scr->windows[WIN_ICON_FIRST + i], NZ_LAYER, 1, rowY, 4, 4, NZ_PLTT_ICON_BASE, baseTile);
+            baseTile += 16;
+            AddWindowParameterized(scr->bgConfig, &scr->windows[WIN_PLATE_FIRST + i], NZ_LAYER, LIST_TEXT_X, rowY, LIST_TEXT_W, LIST_ROW_H, NZ_PLTT_UI, baseTile);
+            baseTile += LIST_TEXT_W * LIST_ROW_H;
+        }
+    }
+}
+
+static void NuzScreen_FreeDisplay(NuzlockeScreen *scr) {
+    if (!scr->displayReady) {
+        return;
+    }
+    NuzScreen_RemoveWindows(scr);
+    // Wipe the layer so nothing is left on screen when the overworld returns.
+    BgClearTilemapBufferAndCommit(scr->bgConfig, NZ_LAYER);
+    ToggleBgLayer(NZ_LAYER, GF_PLANE_TOGGLE_OFF);
+
+    // Put the display back exactly as we found it.
+    GfGfx_SetBanks(&scr->savedBanks);
+    reg_G2_BG2CNT = scr->savedBg2Cnt;
+    *(vu16 *)HW_BG_PLTT = scr->savedBackdrop;
+    reg_GX_DISPCNT = scr->savedDispA;
+    GfGfx_EngineASetPlanes((scr->savedDispA >> 8) & 0x1F);
+    SetBlendBrightness(0, (GXBlendPlaneMask)(GX_BLEND_PLANEMASK_BD | GX_BLEND_PLANEMASK_OBJ | GX_BLEND_PLANEMASK_BG3 | GX_BLEND_PLANEMASK_BG2 | GX_BLEND_PLANEMASK_BG1 | GX_BLEND_PLANEMASK_BG0), SCREEN_MASK_MAIN | SCREEN_MASK_SUB);
+    MessageFormat_Delete(scr->msgFmt);
+    DestroyMsgData(scr->msgData);
+    Heap_Free(scr->iconPlttRaw);
+    FreeBgTilemapBuffer(scr->bgConfig, NZ_LAYER);
+    Heap_Free(scr->bgConfig);
+    scr->displayReady = FALSE;
+}
+
+static void NuzScreen_PrintFont(NuzlockeScreen *scr, Window *window, s32 msgNo, int y, u8 fg, u8 bg, BOOL center, int xOffset) {
+    String *tmpStr = String_New(256, HEAP_ID_FIELD2);
+    String *finStr = String_New(256, HEAP_ID_FIELD2);
+    int x = xOffset;
+    enum Font font = FONT_SYSTEM;
+    int width;
+
+    ReadMsgDataIntoString(scr->msgData, msgNo, tmpStr);
+    StringExpandPlaceholders(scr->msgFmt, finStr, tmpStr);
+    width = FontID_String_GetWidth(font, finStr, 0);
+    if (center) {
+        x = window->width * 8 > width ? (window->width * 8 - width) / 2 : 0;
+    }
+    AddTextPrinterParameterizedWithColor(window, font, finStr, x, y, TEXT_SPEED_NOTRANSFER, MAKE_TEXT_COLOR(fg, NZC_SHADOW, bg), NULL);
+
+    String_Delete(tmpStr);
+    String_Delete(finStr);
+}
+
+static void NuzScreen_Print(NuzlockeScreen *scr, Window *window, s32 msgNo, int y, u8 fg, u8 bg, BOOL center, int xOffset) {
+    NuzScreen_PrintFont(scr, window, msgNo, y, fg, bg, center, xOffset);
+}
+
+static void NuzScreen_DrawIcon(NuzlockeScreen *scr, Window *window, const NuzlockeTeamMon *mon) {
+    NNSG2dCharacterData *charData;
+    void *raw = GfGfxLoader_GetCharData(NARC_poketool_icongra_poke_icon, GetMonIconNaixEx(mon->species, FALSE, mon->form), FALSE, &charData, HEAP_ID_FIELD2);
+    // First animation frame: 32x32 pixels = 16 tiles, same order as a 4x4 window.
+    MI_CpuCopy8(charData->pRawData, window->pixelBuffer, 0x200);
+    Heap_Free(raw);
+    window->paletteNum = NZ_PLTT_ICON_BASE + GetMonIconPaletteEx(mon->species, mon->form, FALSE);
+}
+
+static void NuzScreen_DrawBanner(NuzlockeScreen *scr, s32 titleMsg, u8 bannerColor) {
+    Window *banner = &scr->windows[WIN_BANNER];
+    FillWindowPixelBuffer(banner, bannerColor);
+    FillWindowPixelRect(banner, NZC_DARK, 0, BANNER_H * 8 - 2, 256, 2);
+    NuzScreen_Print(scr, banner, titleMsg, 4, NZC_WHITE, bannerColor, TRUE, 0);
+    if (scr->numPages > 1) {
+        BufferIntegerAsString(scr->msgFmt, 0, scr->page + 1, 2, PRINTING_MODE_LEFT_ALIGN, TRUE);
+        BufferIntegerAsString(scr->msgFmt, 1, scr->numPages, 2, PRINTING_MODE_LEFT_ALIGN, TRUE);
+        NuzScreen_Print(scr, banner, msg_0203_00026, 4, NZC_WHITE, bannerColor, FALSE, scr->numPages > 9 ? 256 - 40 : 256 - 28);
+    }
+    CopyWindowToVram(banner);
+}
+
+static void NuzScreen_DrawLogPage(NuzlockeScreen *scr, SaveData *saveData) {
+    int logCount = Nuzlocke_GetLogCount(saveData);
+    int first = scr->pageArg[scr->page] * PARTY_SIZE;
+    int caught = 0;
+    int i;
+    IGT *igt = Save_PlayerData_GetIGTAddr(saveData);
+
+    int failed = 0;
+    for (i = 0; i < logCount; i++) {
+        u8 status = Nuzlocke_GetLogEntry(saveData, i)->status;
+        if (NUZLOCKE_LOG_IS_SUCCESS(status)) {
+            caught++;
+        } else {
+            failed++;
+        }
+    }
+
+    NuzScreen_DrawBanner(scr, msg_0203_00020, NZC_GREEN); // ENCOUNTER LOG
+
+    Window *info = &scr->windows[WIN_INFO];
+    FillWindowPixelBuffer(info, NZC_CLEAR);
+    BufferIntegerAsString(scr->msgFmt, 0, caught, 3, PRINTING_MODE_LEFT_ALIGN, TRUE);
+    BufferIntegerAsString(scr->msgFmt, 1, failed, 3, PRINTING_MODE_LEFT_ALIGN, TRUE);
+    BufferIntegerAsString(scr->msgFmt, 2, Nuzlocke_GetDeaths(saveData), 3, PRINTING_MODE_LEFT_ALIGN, TRUE);
+    NuzScreen_Print(scr, info, msg_0203_00021, 1, NZC_GOLD_TEXT, NZC_CLEAR, TRUE, 0);
+    BufferPlayersName(scr->msgFmt, 0, Save_PlayerData_GetProfile(saveData));
+    BufferIntegerAsString(scr->msgFmt, 1, PlayerProfile_CountBadges(Save_PlayerData_GetProfile(saveData)), 2, PRINTING_MODE_LEFT_ALIGN, TRUE);
+    BufferIntegerAsString(scr->msgFmt, 2, GetIGTHours(igt), 3, PRINTING_MODE_LEFT_ALIGN, TRUE);
+    BufferIntegerAsString(scr->msgFmt, 3, GetIGTMinutes(igt), 2, PRINTING_MODE_LEADING_ZEROS, TRUE);
+    NuzScreen_Print(scr, info, msg_0203_00022, 16, NZC_GREY, NZC_CLEAR, TRUE, 0);
+    CopyWindowToVram(info);
+
+    for (i = 0; i < PARTY_SIZE; i++) {
+        Window *icon = &scr->windows[WIN_ICON_FIRST + i];
+        Window *plate = &scr->windows[WIN_PLATE_FIRST + i];
+        if (first + i < logCount) {
+            const NuzlockeLogEntry *entry = Nuzlocke_GetLogEntry(saveData, first + i);
+            BOOL ok = NUZLOCKE_LOG_IS_SUCCESS(entry->status);
+            BOOL bonus = NUZLOCKE_LOG_IS_BONUS(entry->status);
+            u8 textColor = bonus ? NZC_GOLD_TEXT : (ok ? NZC_GREEN_TEXT : NZC_RED_TEXT);
+            NuzlockeTeamMon mon;
+
+            MI_CpuClear8(&mon, sizeof(mon));
+            mon.species = entry->species;
+            NuzScreen_DrawIcon(scr, icon, &mon);
+
+            FillWindowPixelBuffer(plate, NZC_PANEL);
+            FillWindowPixelRect(plate, bonus ? NZC_GOLD : (ok ? NZC_GREEN : NZC_RED), 0, 0, CARD_W * 8, 2);
+            BufferSpeciesName(scr->msgFmt, 0, entry->species);
+            if (bonus) {
+                // Bonus entries: species, then what kind of bonus it was.
+                static const u16 sBonusMsgs[] = {
+                    [NUZLOCKE_LOG_SHINY - NUZLOCKE_LOG_SHINY] = msg_0203_00072,
+                    [NUZLOCKE_LOG_GIFT - NUZLOCKE_LOG_SHINY] = msg_0203_00071,
+                    [NUZLOCKE_LOG_STATIC - NUZLOCKE_LOG_SHINY] = msg_0203_00073,
+                    [NUZLOCKE_LOG_STATIC_FAILED - NUZLOCKE_LOG_SHINY] = msg_0203_00074,
+                    [NUZLOCKE_LOG_EGG - NUZLOCKE_LOG_SHINY] = msg_0203_00075,
+                };
+                int kind = entry->status - NUZLOCKE_LOG_SHINY;
+                NuzScreen_Print(scr, plate, msg_0203_00076, 2, NZC_WHITE, NZC_PANEL, TRUE, 0);
+                NuzScreen_Print(scr, plate, kind < (int)NELEMS(sBonusMsgs) ? sBonusMsgs[kind] : msg_0203_00071, 16, ok ? NZC_GOLD_TEXT : NZC_RED_TEXT, NZC_PANEL, TRUE, 0);
+            } else {
+                NuzScreen_Print(scr, plate, ok ? msg_0203_00024 : msg_0203_00025, 2, textColor, NZC_PANEL, TRUE, 0);
+                BufferLocationName(scr->msgFmt, 0, entry->mapsec);
+                NuzScreen_Print(scr, plate, msg_0203_00023, 16, NZC_GREY, NZC_PANEL, TRUE, 0);
+            }
+            // Thin dividers so long place names don't run into the next card.
+            FillWindowPixelRect(plate, NZC_DARK, 0, 2, 1, CARD_PLATE_H * 8 - 2);
+            FillWindowPixelRect(plate, NZC_DARK, CARD_W * 8 - 1, 2, 1, CARD_PLATE_H * 8 - 2);
+        } else {
+            FillWindowPixelBuffer(icon, 0);
+            icon->paletteNum = NZ_PLTT_UI;
+            FillWindowPixelBuffer(plate, NZC_CLEAR);
+        }
+        CopyWindowToVram(icon);
+        CopyWindowToVram(plate);
+    }
+}
+
+// ---------------------------------------------------------------- list rows
+
+static Window *NuzScreen_BeginRow(NuzlockeScreen *scr, int row, u16 species, u8 form, u8 stripeColor) {
+    Window *icon = &scr->windows[WIN_ICON_FIRST + row];
+    Window *text = &scr->windows[WIN_PLATE_FIRST + row];
+    if (species != SPECIES_NONE) {
+        NuzlockeTeamMon mon;
+        MI_CpuClear8(&mon, sizeof(mon));
+        mon.species = species;
+        mon.form = form;
+        NuzScreen_DrawIcon(scr, icon, &mon);
+    } else {
+        FillWindowPixelBuffer(icon, 0);
+        icon->paletteNum = NZ_PLTT_UI;
+    }
+    FillWindowPixelBuffer(text, NZC_PANEL);
+    FillWindowPixelRect(text, stripeColor, 0, 0, 3, LIST_ROW_H * 8 - 2);
+    FillWindowPixelRect(text, NZC_CLEAR, 0, LIST_ROW_H * 8 - 2, LIST_TEXT_W * 8, 2);
+    return text;
+}
+
+static void NuzScreen_EndRow(NuzlockeScreen *scr, int row) {
+    CopyWindowToVram(&scr->windows[WIN_ICON_FIRST + row]);
+    CopyWindowToVram(&scr->windows[WIN_PLATE_FIRST + row]);
+}
+
+static void NuzScreen_ClearRow(NuzlockeScreen *scr, int row) {
+    Window *icon = &scr->windows[WIN_ICON_FIRST + row];
+    FillWindowPixelBuffer(icon, 0);
+    icon->paletteNum = NZ_PLTT_UI;
+    FillWindowPixelBuffer(&scr->windows[WIN_PLATE_FIRST + row], NZC_CLEAR);
+    NuzScreen_EndRow(scr, row);
+}
+
+// msg for "NICK (SPECIES)  Lv.N", or "NICK  Lv.N" when it was never nicknamed.
+static s32 NuzScreen_NameLineMsg(const NuzlockeDeath *info) {
+    u16 nick[POKEMON_NAME_LENGTH + 1];
+    u16 speciesName[POKEMON_NAME_LENGTH + 1];
+    int i;
+    Nuzlocke_DeathRecordGetName(info, nick);
+    GetSpeciesNameIntoArray(info->species, HEAP_ID_FIELD2, speciesName);
+    for (i = 0; i < POKEMON_NAME_LENGTH + 1; i++) {
+        if (nick[i] != speciesName[i]) {
+            return msg_0203_00011;
+        }
+        if (nick[i] == EOS) {
+            break;
+        }
+    }
+    return msg_0203_00080;
+}
+
+static void NuzScreen_BufferNick(NuzlockeScreen *scr, int idx, const NuzlockeDeath *info) {
+    u16 name[POKEMON_NAME_LENGTH + 1];
+    String *str = String_New(POKEMON_NAME_LENGTH + 1, HEAP_ID_FIELD2);
+    Nuzlocke_DeathRecordGetName(info, name);
+    CopyU16ArrayToString(str, name);
+    BufferString(scr->msgFmt, idx, str, 0, 1, 2);
+    String_Delete(str);
+}
+
+static void NuzScreen_BufferTrainerName(NuzlockeScreen *scr, SaveData *saveData, int idx, u16 trainerId) {
+    String *str = String_New(PLAYER_NAME_LENGTH + 1, HEAP_ID_FIELD2);
+    if (TrainerData_GetAttr(trainerId, TRATTR_CLASS) == TRAINERCLASS_RIVAL) {
+        CopyU16ArrayToString(str, Save_Misc_RivalName_Const_Get(Save_Misc_Const_Get(saveData)));
+    } else {
+        MsgData *msgData = NewMsgDataFromNarc(MSGDATA_LOAD_LAZY, NARC_msgdata_msg, msg_0729, HEAP_ID_FIELD2);
+        ReadMsgDataIntoString(msgData, trainerId, str);
+        DestroyMsgData(msgData);
+    }
+    BufferString(scr->msgFmt, idx, str, 0, 1, 2);
+    String_Delete(str);
+}
