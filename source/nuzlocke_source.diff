+    void *iconPlttRaw;
+    NNSG2dPaletteData *iconPltt;
+    // Display state to put back when the screen closes (the overworld
+    // reload after a battle relies on it).
+    GraphicsBanks savedBanks;
+    u32 savedDispA;
+    u16 savedBg2Cnt;
+    u16 savedBackdrop;
+    Window windows[WIN_COUNT];
+    NuzlockeRecord live;
+} NuzlockeScreen;
+
+static NuzlockeScreen *NuzScreen_New(int mode) {
+    NuzlockeScreen *scr = Heap_Alloc(HEAP_ID_FIELD2, sizeof(NuzlockeScreen));
+    GF_ASSERT(scr != NULL);
+    MI_CpuClear8(scr, sizeof(NuzlockeScreen));
+    scr->mode = mode;
+    return scr;
+}
+
+static void NuzScreen_AddRecordPages(NuzlockeScreen *scr, SaveData *saveData) {
+    NuzlockeSave *nz = Save_Nuzlocke_Get(saveData);
+    int logCount = Nuzlocke_GetLogCount(saveData);
+    int i;
+    for (i = 0; i * PARTY_SIZE < logCount; i++) {
+        scr->pageArg[scr->numPages] = i;
+        scr->pages[scr->numPages++] = NZ_PAGE_LOG;
+    }
+    if (nz->records[NUZLOCKE_RECORD_CHAMPION].valid) {
+        scr->pages[scr->numPages++] = NZ_PAGE_CHAMPION;
+    }
+    if (nz->records[NUZLOCKE_RECORD_RED].valid) {
+        scr->pages[scr->numPages++] = NZ_PAGE_RED;
+    }
+}
