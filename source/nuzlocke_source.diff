+// The save reserves MAX_APRICORN_TREE (128) apricorn tree slots, but the game
+// only uses NUM_APRICORN_TREE (31). The Nuzlocke data lives in the unused tail
+// (slots 32..127 = 384 bytes).
+#define NUZLOCKE_TREE_OFFSET 32
+
+// Compile-time check that the Nuzlocke data fits in the free space.
+typedef char NuzlockeSaveFits[(sizeof(NuzlockeSave) <= (MAX_APRICORN_TREE - NUZLOCKE_TREE_OFFSET) * sizeof(APRICORN_TREE)) ? 1 : -1];
+
+static u8 sCatchBlocked;
+static u8 sRulesActiveInBattle;
+static s8 sPendingVictory = -1;
+static u8 sTestMode; // RAM only: cleared on every power-on
+static u8 sLogPending;
+static u8 sAutosaveRequested; // set when a battle changed something worth saving
+static u8 sLogPendingMapsec;
+static u8 sRandomEncounter;  // this battle came from grass/water/etc.
+static u8 sShinyEncounter;   // ...and the wild Pokemon was shiny
+static u8 sCaughtValid;
+static u8 sCaughtToPC;
+static NuzlockeDeath sCaught; // the Pokemon caught in this battle (after naming)
+static u8 sEventCount;
+static NuzlockeEvent sEvents[NUZLOCKE_MAX_EVENTS];
+
+// ------------------------------------------------------------------
+// Encounter log storage. Mystery Gift can't be used (no wireless or
+// Wi-Fi), so the text area of the last Wonder Card slot holds the log.
+// The slot's own header is never touched, so the game still sees it as
+// empty.
+// ------------------------------------------------------------------
+typedef char NuzlockeLogFits[(NUZLOCKE_LOG_MAX * sizeof(NuzlockeLogEntry) <= sizeof(((WonderCard *)0)->text)) ? 1 : -1];
+
+static BOOL Nuzlocke_IsAreaUsed(NuzlockeSave *nz, u32 mapsec);
+
+static NuzlockeLogEntry *Nuzlocke_LogBase(SaveData *saveData) {
+    MysteryGiftSave *mg = SaveArray_Get(saveData, SAVE_MYSTERY_GIFT);
+    return (NuzlockeLogEntry *)mg->cards[NUM_SAVED_WONDER_CARDS - 1].text;
+}
+
+int Nuzlocke_GetLogCount(SaveData *saveData) {
+    NuzlockeLogEntry *log = Nuzlocke_LogBase(saveData);
+    int i;
+    for (i = 0; i < NUZLOCKE_LOG_MAX; i++) {
+        if (log[i].status == NUZLOCKE_LOG_EMPTY) {
+            break;
+        }
+    }
+    return i;
+}
+
+const NuzlockeLogEntry *Nuzlocke_GetLogEntry(SaveData *saveData, int index) {
+    return &Nuzlocke_LogBase(saveData)[index];
+}
+
+const NuzlockeLogEntry *Nuzlocke_FindLogEntry(SaveData *saveData, u32 mapsec) {
+    NuzlockeLogEntry *log = Nuzlocke_LogBase(saveData);
+    int count = Nuzlocke_GetLogCount(saveData);
+    int i;
+    for (i = 0; i < count; i++) {
+        if (log[i].mapsec == mapsec && !NUZLOCKE_LOG_IS_BONUS(log[i].status)) {
+            return &log[i];
+        }
+    }
+    return NULL;
+}
+
+// Bonus entries (shiny, gift, one-time encounters, Eggs) are added to the
+// end of the log and never use up an area.
+static void Nuzlocke_AddBonusLog(SaveData *saveData, u32 mapsec, u16 species, u8 status) {
+    NuzlockeLogEntry *log = Nuzlocke_LogBase(saveData);
+    int count = Nuzlocke_GetLogCount(saveData);
+    if (count >= NUZLOCKE_LOG_MAX || species == SPECIES_NONE) {
+        return;
+    }
+    log[count].mapsec = mapsec;
+    log[count].species = species;
+    log[count].status = status;
+    SaveSubstruct_UpdateCRC(SAVE_MYSTERY_GIFT);
+}
+
+// ------------------------------------------------------------------
+// Death records. Stored in the text areas of the first two Wonder Card
+// slots and the special Wonder Card (15 records of 32 bytes each).
+// ------------------------------------------------------------------
+typedef char NuzlockeDeathsFit[(NUZLOCKE_DEATHS_PER_AREA * sizeof(NuzlockeDeath) <= sizeof(((WonderCard *)0)->text)) ? 1 : -1];
+typedef char NuzlockeDeathSize[(sizeof(NuzlockeDeath) == 32) ? 1 : -1];
+
+static NuzlockeDeath *Nuzlocke_DeathSlot(SaveData *saveData, int index) {
+    MysteryGiftSave *mg = SaveArray_Get(saveData, SAVE_MYSTERY_GIFT);
+    WonderCard *card;
+    int area = index / NUZLOCKE_DEATHS_PER_AREA;
+    if (area < NUM_SAVED_WONDER_CARDS - 1) {
+        card = &mg->cards[area];
+    } else {
+        card = &mg->specialWonderCard;
+    }
+    return &((NuzlockeDeath *)card->text)[index % NUZLOCKE_DEATHS_PER_AREA];
+}
+
+int Nuzlocke_GetDeathRecordCount(SaveData *saveData) {
+    int i;
+    for (i = 0; i < NUZLOCKE_DEATHS_MAX; i++) {
+        if (Nuzlocke_DeathSlot(saveData, i)->species == SPECIES_NONE) {
+            break;
+        }
+    }
+    return i;
+}
+
+const NuzlockeDeath *Nuzlocke_GetDeathRecord(SaveData *saveData, int index) {
+    return Nuzlocke_DeathSlot(saveData, index);
+}
+
+void Nuzlocke_DeathRecordGetName(const NuzlockeDeath *death, u16 *dest) {
+    int i;
+    for (i = 0; i < NUZLOCKE_DEATH_NAME_LEN && death->nickname[i] != EOS; i++) {
+        dest[i] = death->nickname[i];
+    }
+    dest[i] = EOS;
+}
+
+static void Nuzlocke_FillMonInfo(NuzlockeDeath *info, Pokemon *mon, u32 mapsec) {
+    u16 name[POKEMON_NAME_LENGTH + 1];
+    int i;
+    MI_CpuClear8(info, sizeof(NuzlockeDeath));
+    info->species = GetMonData(mon, MON_DATA_SPECIES, NULL);
+    info->level = GetMonData(mon, MON_DATA_LEVEL, NULL);
+    info->form = GetMonData(mon, MON_DATA_FORM, NULL);
+    info->mapsec = mapsec;
+    GetMonData(mon, MON_DATA_NICKNAME, name);
+    for (i = 0; i < NUZLOCKE_DEATH_NAME_LEN; i++) {
+        info->nickname[i] = name[i];
+        if (name[i] == EOS) {
+            break;
+        }
+    }
+}
+
+static void Nuzlocke_AddEvent(u8 kind, u8 detail, const NuzlockeDeath *info) {
+    NuzlockeEvent *event;
+    if (sEventCount >= NUZLOCKE_MAX_EVENTS) {
+        // Keep the most recent events.
+        MI_CpuCopy8(&sEvents[1], &sEvents[0], sizeof(NuzlockeEvent) * (NUZLOCKE_MAX_EVENTS - 1));
+        sEventCount = NUZLOCKE_MAX_EVENTS - 1;
+    }
+    event = &sEvents[sEventCount++];
+    event->kind = kind;
+    event->detail = detail;
+    if (info != NULL) {
+        event->info = *info;
+    } else {
+        MI_CpuClear8(&event->info, sizeof(NuzlockeDeath));
+    }
+}
+
+int Nuzlocke_GetEventCount(void) {
+    return sEventCount;
+}
+
+const NuzlockeEvent *Nuzlocke_GetEvent(int index) {
+    return &sEvents[index];
+}
+
+// Records how a party Pokemon died (cause from the battle engine).
+static void Nuzlocke_RecordDeath(SaveData *saveData, Pokemon *mon, u32 mapsec) {
+    NuzlockeDeath info;
+    int count = Nuzlocke_GetDeathRecordCount(saveData);
+
+    Nuzlocke_FillMonInfo(&info, mon, mapsec);
+    if (!Nuzlocke_GetFaintCause(GetMonData(mon, MON_DATA_PERSONALITY, NULL), &info.cause, &info.foeSpecies, &info.trainerId, &info.move)) {
+        info.cause = NUZLOCKE_CAUSE_UNKNOWN;
+    }
+    if (count < NUZLOCKE_DEATHS_MAX) {
+        *Nuzlocke_DeathSlot(saveData, count) = info;
+        SaveSubstruct_UpdateCRC(SAVE_MYSTERY_GIFT);
+    }
+    Nuzlocke_AddEvent(NUZLOCKE_EVENT_DEATH, 0, &info);
+}
+
+void Nuzlocke_OnMonCaught(Pokemon *mon, BOOL sentToPC) {
+    Nuzlocke_FillMonInfo(&sCaught, mon, 0);
+    sCaughtValid = TRUE;
+    sCaughtToPC = sentToPC;
+}
+
+// ------------------------------------------------------------------
+// Gifts
+// ------------------------------------------------------------------
+void Nuzlocke_OnGiftMon(SaveData *saveData, Pokemon *mon, u32 mapsec, u8 logKind) {
+#if NUZLOCKE_FORCE_NICKNAMES
+    if (logKind != NUZLOCKE_LOG_EGG) { // hatching has its own naming screen
+        u8 flag = TRUE;
+        SetMonData(mon, NUZLOCKE_NAME_MARKER, &flag);
+    }
+#endif
+    Nuzlocke_AddBonusLog(saveData, mapsec, GetMonData(mon, MON_DATA_SPECIES, NULL), logKind);
+}
+
+// A received Pokemon that wasn't given a nickname in the event that gave
+// it gets the naming screen as soon as the player is back in control.
+typedef struct NuzlockeGiftNaming {
+    u8 state;
+    u8 slot;
+    u16 result;
+} NuzlockeGiftNaming;
+
+static BOOL Task_NuzlockeGiftNaming(TaskManager *taskManager) {
+    FieldSystem *fieldSystem = TaskManager_GetFieldSystem(taskManager);
+    NuzlockeGiftNaming *env = TaskManager_GetEnvironment(taskManager);
+    Party *party = SaveArray_Party_Get(fieldSystem->saveData);
+
+    switch (env->state) {
+    case 0:
+        MapObjectManager_PauseAllMovement(fieldSystem->mapObjectManager);
+        BeginNormalPaletteFade(FADE_BOTH_SCREENS, FADE_TYPE_BRIGHTNESS_OUT, FADE_TYPE_BRIGHTNESS_OUT, RGB_BLACK, 6, 1, HEAP_ID_FIELD3);
+        env->state++;
+        break;
+    case 1:
+        if (IsPaletteFadeFinished()) {
+            Pokemon *mon = Party_GetMonByIndex(party, env->slot);
+            CallTask_NamingScreen(taskManager, NAME_SCREEN_POKEMON, GetMonData(mon, MON_DATA_SPECIES, NULL), POKEMON_NAME_LENGTH, env->slot, NULL, &env->result);
+            env->state++;
+        }
+        break;
+    case 2: {
+        u8 flag = FALSE;
+        SetMonData(Party_GetMonByIndex(party, env->slot), NUZLOCKE_NAME_MARKER, &flag);
+        BeginNormalPaletteFade(FADE_BOTH_SCREENS, FADE_TYPE_BRIGHTNESS_IN, FADE_TYPE_BRIGHTNESS_IN, RGB_BLACK, 6, 1, HEAP_ID_FIELD3);
+        env->state++;
+        break;
+    }
+    case 3:
+        if (IsPaletteFadeFinished()) {
+            MapObjectManager_UnpauseAllMovement(fieldSystem->mapObjectManager);
+            Heap_Free(env);
+            return TRUE;
+        }
+        break;
+    }
+    return FALSE;
+}
+
+BOOL Nuzlocke_TryStartGiftNaming(FieldSystem *fieldSystem) {
+#if NUZLOCKE_FORCE_NICKNAMES
+    Party *party = SaveArray_Party_Get(fieldSystem->saveData);
+    int i;
+    for (i = 0; i < Party_GetCount(party); i++) {
+        Pokemon *mon = Party_GetMonByIndex(party, i);
+        if (!GetMonData(mon, NUZLOCKE_NAME_MARKER, NULL)) {
+            continue;
+        }
+        if (GetMonData(mon, MON_DATA_HAS_NICKNAME, NULL) || GetMonData(mon, MON_DATA_IS_EGG, NULL)) {
+            u8 flag = FALSE;
+            SetMonData(mon, NUZLOCKE_NAME_MARKER, &flag); // already named
+            continue;
+        }
+        NuzlockeGiftNaming *env = Heap_Alloc(HEAP_ID_FIELD2, sizeof(NuzlockeGiftNaming));
+        env->state = 0;
+        env->slot = i;
+        env->result = 0;
+        FieldSystem_CreateTask(fieldSystem, Task_NuzlockeGiftNaming, env);
+        return TRUE;
+    }
+#endif
+    return FALSE;
+}
+
+// ------------------------------------------------------------------
+// Area status popup
+// ------------------------------------------------------------------
+int Nuzlocke_GetAreaStatus(SaveData *saveData, u32 mapsec, u16 *species) {
+    NuzlockeSave *nz = Save_Nuzlocke_Get(saveData);
+    const NuzlockeLogEntry *entry;
+    if (!nz->rulesActive || nz->runOver || sTestMode) {
+        return -1;
+    }
+    entry = Nuzlocke_FindLogEntry(saveData, mapsec);
+    if (entry != NULL) {
+        *species = entry->species;
+        return entry->status;
+    }
+    if (Nuzlocke_IsAreaUsed(nz, mapsec)) {
+        return -1; // used before the log existed
+    }
+    *species = SPECIES_NONE;
+    return NUZLOCKE_LOG_EMPTY;
+}
+
+static void Nuzlocke_SetLog(SaveData *saveData, u32 mapsec, u16 species, u8 status) {
+    NuzlockeLogEntry *log = Nuzlocke_LogBase(saveData);
+    NuzlockeLogEntry *entry = (NuzlockeLogEntry *)Nuzlocke_FindLogEntry(saveData, mapsec);
+    if (entry == NULL) {
+        int count = Nuzlocke_GetLogCount(saveData);
+        if (count >= NUZLOCKE_LOG_MAX) {
+            return;
+        }
+        entry = &log[count];
+        entry->mapsec = mapsec;
+    }
+    if (species != SPECIES_NONE) {
+        entry->species = species;
+    }
+    entry->status = status;
+    SaveSubstruct_UpdateCRC(SAVE_MYSTERY_GIFT);
+}
+
+static void Nuzlocke_CheckVictory(BattleSetup *setup, SaveData *saveData);
+
+NuzlockeSave *Save_Nuzlocke_Get(SaveData *saveData) {
+    SAVE_MISC_DATA *misc = Save_Misc_Get(saveData);
+    return (NuzlockeSave *)&misc->apricorn_trees[NUZLOCKE_TREE_OFFSET];
+}
+
+static BOOL Nuzlocke_IsAreaUsed(NuzlockeSave *nz, u32 mapsec) {
+    if (mapsec >= sizeof(nz->areaUsed) * 8) {
+        return FALSE;
+    }
+    return (nz->areaUsed[mapsec / 8] >> (mapsec % 8)) & 1;
+}
+
+static void Nuzlocke_SetAreaUsed(NuzlockeSave *nz, u32 mapsec) {
+    if (mapsec >= sizeof(nz->areaUsed) * 8) {
+        return;
+    }
+    nz->areaUsed[mapsec / 8] |= (1 << (mapsec % 8));
+}
+
+static void Nuzlocke_NameGraveyard(SaveData *saveData) {
+    MsgData *msgData = NewMsgDataFromNarc(MSGDATA_LOAD_LAZY, NARC_msgdata_msg, msg_0203, HEAP_ID_FIELD2);
+    String *name = NewString_ReadMsgData(msgData, msg_0203_00005); // GRAVEYARD
+    PCStorage_SetBoxName(SaveArray_PCStorage_Get(saveData), NUZLOCKE_GRAVEYARD_BOX, name);
+    String_Delete(name);
+    DestroyMsgData(msgData);
+}
+
+BOOL Nuzlocke_UpdateRulesActive(SaveData *saveData) {
+    NuzlockeSave *nz = Save_Nuzlocke_Get(saveData);
+    if (!nz->rulesActive) {
+        // The challenge starts the first time the player has Poke Balls.
+        if (Bag_PocketNotEmpty(Save_Bag_Get(saveData), POCKET_BALLS)) {
+            nz->rulesActive = TRUE;
+        }
+    }
+    if (nz->rulesActive && !nz->graveyardNamed) {
+        Nuzlocke_NameGraveyard(saveData);
+        nz->graveyardNamed = TRUE;
+    }
+    return nz->rulesActive;
+}
+
+BOOL Nuzlocke_IsRunOver(SaveData *saveData) {
+#if NUZLOCKE_WIPEOUT_ENDS
+    return Save_Nuzlocke_Get(saveData)->runOver;
+#else
+    return FALSE;
+#endif
+}
+
+u16 Nuzlocke_GetDeaths(SaveData *saveData) {
+    return Save_Nuzlocke_Get(saveData)->deaths;
+}
+
+BOOL Nuzlocke_ShouldAutosave(SaveData *saveData) {
+#if NUZLOCKE_AUTOSAVE
+    NuzlockeSave *nz = Save_Nuzlocke_Get(saveData);
+    return nz->rulesActive && !nz->runOver && !sTestMode;
+#else
+    return FALSE;
+#endif
+}
