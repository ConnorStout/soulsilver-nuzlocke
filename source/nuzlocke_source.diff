+BOOL Nuzlocke_TakeAutosaveRequest(SaveData *saveData) {
+    BOOL ret = sAutosaveRequested && Nuzlocke_ShouldAutosave(saveData);
+    sAutosaveRequested = FALSE;
+    return ret;
+}
