new file mode 100644
index 0000000..6c7d66c
--- /dev/null
+++ b/src/application/pokegear/map/nuzlocke_pgmap.c
@@ -0,0 +1,125 @@
+// ------------------------------------------------------------------
+// Nuzlocke view for the Pokegear map. Press SELECT on the map to switch.
+// The info panel then shows the first encounter of the highlighted area:
+// the Pokemon's icon, its name and whether it was caught.
+// ------------------------------------------------------------------
+#include "global.h"
+
+#include "constants/sndseq.h"
+
+#include "application/pokegear/map/pokegear_map_internal.h"
+#include "msgdata/msg.naix"
+#include "msgdata/msg/msg_0203.h"
+
+#include "bg_window.h"
+#include "font.h"
+#include "gf_gfx_loader.h"
+#include "heap.h"
+#include "map_header.h"
+#include "message_format.h"
+#include "msgdata.h"
+#include "nuzlocke.h"
+#include "nuzlocke_pgmap.h"
+#include "palette.h"
+#include "pm_string.h"
+#include "pokemon_icon_idx.h"
+#include "sound.h"
+#include "system.h"
+#include "text.h"
+#include "unk_02005D10.h"
+
+#define NZ_PGMAP_ICON_PLTT     12     // sub BG palettes 12..15 (unused by the Pokegear map)
+#define NZ_PGMAP_ICON_BASETILE 0x200  // free tiles on SUB_1 (SUB_2 graphics end at 0x60, windows start at 0x2CE)
+
+static u8 sNuzlockeView;
+static u8 sIconWindowAdded;
+static Window sIconWindow;
+
+void NuzlockePgMap_Init(PokegearMapAppData *mapApp) {
+    PaletteData_LoadNarc(mapApp->pokegear->plttData, NARC_poketool_icongra_poke_icon, sub_02074490(), mapApp->heapID, PLTTBUF_SUB_BG, 0x80, NZ_PGMAP_ICON_PLTT * 16);
+    sIconWindowAdded = FALSE;
+}
+
+void NuzlockePgMap_Free(PokegearMapAppData *mapApp) {
+    if (sIconWindowAdded) {
+        ClearWindowTilemapAndCopyToVram(&sIconWindow);
+        RemoveWindow(&sIconWindow);
+        sIconWindowAdded = FALSE;
+    }
+}
+
+BOOL NuzlockePgMap_HandleKeys(PokegearMapAppData *mapApp) {
+    if (mapApp->type != PGMAP_TYPE_GEAR || !(gSystem.newKeys & PAD_BUTTON_SELECT)) {
+        return FALSE;
+    }
+    if (mapApp->draggingMarking || mapApp->unk_139_1 || mapApp->unk_139_2) {
+        return FALSE;
+    }
+    sNuzlockeView ^= 1;
+    PlaySE(SEQ_SE_GS_GEARDECIDE);
+    ov101_021EAD90(mapApp, FALSE); // redraw the info panel
+    return TRUE;
+}
+
+static void NuzlockePgMap_Print(Window *window, MsgData *msgData, MessageFormat *msgFmt, s32 msgNo, int x, int y, enum HeapID heapID) {
+    String *tmpStr = String_New(128, heapID);
+    String *finStr = String_New(128, heapID);
+    ReadMsgDataIntoString(msgData, msgNo, tmpStr);
+    StringExpandPlaceholders(msgFmt, finStr, tmpStr);
+    AddTextPrinterParameterizedWithColor(window, FONT_SYSTEM, finStr, x, y, TEXT_SPEED_NOTRANSFER, MAKE_TEXT_COLOR(1, 2, 0), NULL);
+    String_Delete(tmpStr);
+    String_Delete(finStr);
+}
+
+// Called at the end of the info-panel redraw (ov101_021EAA0C).
+void NuzlockePgMap_Draw(PokegearMapAppData *mapApp) {
+    const PokegearMapLocationSpec *spec = mapApp->selectedLoc.locationSpec;
+    const NuzlockeLogEntry *entry = NULL;
+    Window *info = &mapApp->windows[2];
+    MsgData *msgData;
+    MessageFormat *msgFmt;
+
+    if (!sNuzlockeView || mapApp->type != PGMAP_TYPE_GEAR) {
+        if (sIconWindowAdded) {
+            // The normal info panel has already been redrawn over it.
+            RemoveWindow(&sIconWindow);
+            sIconWindowAdded = FALSE;
+        }
+        return;
+    }
+    if (spec != NULL) {
+        entry = Nuzlocke_FindLogEntry(mapApp->pokegear->saveData, MapHeader_GetMapSec(spec->mapId));
+    }
+
+    msgData = NewMsgDataFromNarc(MSGDATA_LOAD_LAZY, NARC_msgdata_msg, msg_0203, mapApp->heapID);
+    msgFmt = MessageFormat_New(mapApp->heapID);
+
+    FillWindowPixelBuffer(info, 0);
+    if (entry != NULL) {
+        BufferSpeciesName(msgFmt, 0, entry->species);
+        NuzlockePgMap_Print(info, msgData, msgFmt, entry->status == NUZLOCKE_LOG_CAUGHT ? msg_0203_00027 : msg_0203_00028, 40, 0, mapApp->heapID);
+    } else if (spec != NULL) {
+        NuzlockePgMap_Print(info, msgData, msgFmt, msg_0203_00029, 40, 0, mapApp->heapID);
+    }
+    NuzlockePgMap_Print(info, msgData, msgFmt, msg_0203_00030, 40, 16, mapApp->heapID);
+    CopyWindowToVram(info);
+
+    if (!sIconWindowAdded) {
+        AddWindowParameterized(mapApp->pokegear->bgConfig, &sIconWindow, GF_BG_LYR_SUB_1, info->tilemapLeft, info->tilemapTop, 4, 4, NZ_PGMAP_ICON_PLTT, NZ_PGMAP_ICON_BASETILE);
+        sIconWindowAdded = TRUE;
+    }
+    if (entry != NULL) {
+        NNSG2dCharacterData *charData;
+        void *raw = GfGfxLoader_GetCharData(NARC_poketool_icongra_poke_icon, GetMonIconNaixEx(entry->species, FALSE, 0), FALSE, &charData, mapApp->heapID);
+        MI_CpuCopy8(charData->pRawData, sIconWindow.pixelBuffer, 0x200);
+        Heap_Free(raw);
+        sIconWindow.paletteNum = NZ_PGMAP_ICON_PLTT + GetMonIconPaletteEx(entry->species, 0, FALSE);
+    } else {
+        FillWindowPixelBuffer(&sIconWindow, 0);
+    }
+    CopyWindowToVram(&sIconWindow);
+    ScheduleBgTilemapBufferTransfer(mapApp->pokegear->bgConfig, GF_BG_LYR_SUB_1);
+
+    MessageFormat_Delete(msgFmt);
+    DestroyMsgData(msgData);
+}
