+#include "heap.h"
+#include "map_header.h"
+#include "msgdata.h"
+#include "party.h"
+#include "pm_string.h"
+#include "pokemon.h"
+#include "pokemon_storage_system.h"
+#include "save_arrays.h"
+#include "save_misc_data.h"
+
+#include "constants/trainers.h"
+
+#include "igt.h"
+#include "mystery_gift.h"
+#include "player_data.h"
+#include "pokedex.h"
+
+// The save reserves MAX_APRICORN_TREE (128) apricorn tree slots, but the game
+// only uses NUM_APRICORN_TREE (31). The Nuzlocke data lives in the unused tail
+// (slots 32..127 = 384 bytes).
+#define NUZLOCKE_TREE_OFFSET 32
+
+// Compile-time check that the Nuzlocke data fits in the free space.
+typedef char NuzlockeSaveFits[(sizeof(NuzlockeSave) <= (MAX_APRICORN_TREE - NUZLOCKE_TREE_OFFSET) * sizeof(APRICORN_TREE)) ? 1 : -1];
+
+static u8 sCatchBlocked;
+static u8 sRulesActiveInBattle;
+static s8 sPendingVictory = -1;
+static u8 sTestMode; // RAM only: cleared on every power-on
+static u8 sLogPending;
+static u8 sLogPendingMapsec;
+
+// ------------------------------------------------------------------
+// Encounter log storage. Mystery Gift can't be used (no wireless or
+// Wi-Fi), so the text area of the last Wonder Card slot holds the log.
+// The slot's own header is never touched, so the game still sees it as
+// empty.
+// ------------------------------------------------------------------
+typedef char NuzlockeLogFits[(NUZLOCKE_LOG_MAX * sizeof(NuzlockeLogEntry) <= sizeof(((WonderCard *)0)->text)) ? 1 : -1];
+
+static NuzlockeLogEntry *Nuzlocke_LogBase(SaveData *saveData) {
+    MysteryGiftSave *mg = SaveArray_Get(saveData, SAVE_MYSTERY_GIFT);
+    return (NuzlockeLogEntry *)mg->cards[NUM_SAVED_WONDER_CARDS - 1].text;
+}
+
+int Nuzlocke_GetLogCount(SaveData *saveData) {
+    NuzlockeLogEntry *log = Nuzlocke_LogBase(saveData);
+    int i;
+    for (i = 0; i < NUZLOCKE_LOG_MAX; i++) {
+        if (log[i].status == NUZLOCKE_LOG_EMPTY) {
+            break;
+        }
+    }
+    return i;
+}
+
+const NuzlockeLogEntry *Nuzlocke_GetLogEntry(SaveData *saveData, int index) {
+    return &Nuzlocke_LogBase(saveData)[index];
+}
+
+const NuzlockeLogEntry *Nuzlocke_FindLogEntry(SaveData *saveData, u32 mapsec) {
+    NuzlockeLogEntry *log = Nuzlocke_LogBase(saveData);
+    int count = Nuzlocke_GetLogCount(saveData);
+    int i;
+    for (i = 0; i < count; i++) {
+        if (log[i].mapsec == mapsec) {
+            return &log[i];
+        }
+    }
+    return NULL;
+}
+
+static void Nuzlocke_SetLog(SaveData *saveData, u32 mapsec, u16 species, u8 status) {
+    NuzlockeLogEntry *log = Nuzlocke_LogBase(saveData);
+    NuzlockeLogEntry *entry = (NuzlockeLogEntry *)Nuzlocke_FindLogEntry(saveData, mapsec);
+    if (entry == NULL) {
+        int count = Nuzlocke_GetLogCount(saveData);
+        if (count >= NUZLOCKE_LOG_MAX) {
+            return;
+        }
+        entry = &log[count];
+        entry->mapsec = mapsec;
+    }
+    if (species != SPECIES_NONE) {
+        entry->species = species;
+    }
+    entry->status = status;
+    SaveSubstruct_UpdateCRC(SAVE_MYSTERY_GIFT);
+}
+
+static void Nuzlocke_CheckVictory(BattleSetup *setup, SaveData *saveData);
+
+NuzlockeSave *Save_Nuzlocke_Get(SaveData *saveData) {
+    SAVE_MISC_DATA *misc = Save_Misc_Get(saveData);
+    return (NuzlockeSave *)&misc->apricorn_trees[NUZLOCKE_TREE_OFFSET];
+}
+
+static BOOL Nuzlocke_IsAreaUsed(NuzlockeSave *nz, u32 mapsec) {
+    if (mapsec >= sizeof(nz->areaUsed) * 8) {
+        return FALSE;
+    }
+    return (nz->areaUsed[mapsec / 8] >> (mapsec % 8)) & 1;
+}
+
+static void Nuzlocke_SetAreaUsed(NuzlockeSave *nz, u32 mapsec) {
+    if (mapsec >= sizeof(nz->areaUsed) * 8) {
+        return;
+    }
+    nz->areaUsed[mapsec / 8] |= (1 << (mapsec % 8));
+}
+
+static void Nuzlocke_NameGraveyard(SaveData *saveData) {
+    MsgData *msgData = NewMsgDataFromNarc(MSGDATA_LOAD_LAZY, NARC_msgdata_msg, msg_0203, HEAP_ID_FIELD2);
+    String *name = NewString_ReadMsgData(msgData, msg_0203_00005); // GRAVEYARD
+    PCStorage_SetBoxName(SaveArray_PCStorage_Get(saveData), NUZLOCKE_GRAVEYARD_BOX, name);
+    String_Delete(name);
+    DestroyMsgData(msgData);
+}
+
+BOOL Nuzlocke_UpdateRulesActive(SaveData *saveData) {
+    NuzlockeSave *nz = Save_Nuzlocke_Get(saveData);
+    if (!nz->rulesActive) {
+        // The challenge starts the first time the player has Poke Balls.
+        if (Bag_PocketNotEmpty(Save_Bag_Get(saveData), POCKET_BALLS)) {
+            nz->rulesActive = TRUE;
+        }
+    }
+    if (nz->rulesActive && !nz->graveyardNamed) {
+        Nuzlocke_NameGraveyard(saveData);
+        nz->graveyardNamed = TRUE;
+    }
+    return nz->rulesActive;
+}
+
+BOOL Nuzlocke_IsRunOver(SaveData *saveData) {
+#if NUZLOCKE_WIPEOUT_ENDS
+    return Save_Nuzlocke_Get(saveData)->runOver;
+#else
+    return FALSE;
+#endif
+}
+
+u16 Nuzlocke_GetDeaths(SaveData *saveData) {
+    return Save_Nuzlocke_Get(saveData)->deaths;
+}
+
+BOOL Nuzlocke_ShouldAutosave(SaveData *saveData) {
+#if NUZLOCKE_AUTOSAVE
+    NuzlockeSave *nz = Save_Nuzlocke_Get(saveData);
+    return nz->rulesActive && !nz->runOver && !sTestMode;
+#else
+    return FALSE;
+#endif
+}
+
+BOOL Nuzlocke_IsCatchBlocked(void) {
+    return sCatchBlocked;
+}
+
+BOOL Nuzlocke_RulesActiveInBattle(void) {
+    return sRulesActiveInBattle;
+}
+
+// Called at the very start of a random wild encounter (grass, cave, water,
+// fishing, headbutt, rock smash, Safari Zone), while the overworld is
+// still loaded.
+BOOL Nuzlocke_OnRandomEncounterStart(FieldSystem *fieldSystem, BattleSetup *setup) {
+    sCatchBlocked = FALSE;
+#if NUZLOCKE_ENCOUNTER_RULE
+    if (!Nuzlocke_UpdateRulesActive(fieldSystem->saveData)) {
+        return FALSE;
+    }
+    if (setup->battleType & (BATTLE_TYPE_TRAINER | BATTLE_TYPE_LINK | BATTLE_TYPE_ROAMER | BATTLE_TYPE_TUTORIAL | BATTLE_TYPE_PAL_PARK | BATTLE_TYPE_BUG_CONTEST | BATTLE_TYPE_FRONTIER)) {
+        return FALSE;
+    }
+
+    NuzlockeSave *nz = Save_Nuzlocke_Get(fieldSystem->saveData);
+    Pokemon *wildMon = Party_GetMonByIndex(setup->party[BATTLER_ENEMY], 0);
+    u32 mapsec = MapHeader_GetMapSec(fieldSystem->location->mapId);
+
+#if NUZLOCKE_SHINY_CLAUSE
+    if (MonIsShiny(wildMon)) {
+        // Shiny clause: always catchable, and doesn't use up the area.
+        return FALSE;
+    }
+#endif
+
+    if (Nuzlocke_IsAreaUsed(nz, mapsec)) {
+        sCatchBlocked = TRUE;
+        return FALSE;
+    }
+
+    // First encounter here: it counts whether it's caught, flees or faints.
+    // It's logged as failed now (so a reset can't undo it) and upgraded to
+    // caught when the battle ends with a capture.
+    Nuzlocke_SetAreaUsed(nz, mapsec);
+    Nuzlocke_SetLog(fieldSystem->saveData, mapsec, GetMonData(wildMon, MON_DATA_SPECIES, NULL), NUZLOCKE_LOG_FAILED);
+    sLogPending = TRUE;
+    sLogPendingMapsec = mapsec;
+    return TRUE;
+#else
+    return FALSE;
+#endif
+}
+
+void Nuzlocke_OnBattleStart(FieldSystem *fieldSystem) {
+    sRulesActiveInBattle = Nuzlocke_UpdateRulesActive(fieldSystem->saveData);
+}
+
+static BOOL Nuzlocke_MonIsDead(Pokemon *mon) {
+    return GetMonData(mon, NUZLOCKE_DEAD_MARKER, NULL) != 0;
+}
+
+static BOOL Nuzlocke_MonCanFight(Pokemon *mon) {
+    return GetMonData(mon, MON_DATA_SPECIES_EXISTS, NULL)
+        && !GetMonData(mon, MON_DATA_IS_EGG, NULL)
+        && GetMonData(mon, MON_DATA_HP, NULL) != 0
+        && !Nuzlocke_MonIsDead(mon);
+}
+
+// Puts a party Pokemon in the graveyard box (or any free box slot if the
+// graveyard is full) and removes it from the party.
+static void Nuzlocke_BuryPartyMon(SaveData *saveData, Party *party, int slot) {
+    PCStorage *pc = SaveArray_PCStorage_Get(saveData);
+    Pokemon *mon = Party_GetMonByIndex(party, slot);
+    BoxPokemon *boxMon = Mon_GetBoxMon(mon);
+
+    if (!PCStorage_PlaceMonInBoxFirstEmptySlot(pc, NUZLOCKE_GRAVEYARD_BOX, boxMon)) {
+        PCStorage_PlaceMonInFirstEmptySlotInAnyBox(pc, boxMon);
+    }
+    Party_RemoveMon(party, slot);
+}
+
+void Nuzlocke_OnBattleEnd(BattleSetup *setup, FieldSystem *fieldSystem) {
+    sCatchBlocked = FALSE;
+
+    if (sLogPending) {
+        if (setup->winFlag == BATTLE_OUTCOME_MON_CAUGHT) {
+            Nuzlocke_SetLog(fieldSystem->saveData, sLogPendingMapsec, SPECIES_NONE, NUZLOCKE_LOG_CAUGHT);
+        }
+        sLogPending = FALSE;
+    }
+
+#if NUZLOCKE_PERMADEATH
+    SaveData *saveData = fieldSystem->saveData;
+    if (setup->battleType & (BATTLE_TYPE_LINK | BATTLE_TYPE_FRONTIER | BATTLE_TYPE_DEBUG)) {
+        return;
+    }
+    if (!Nuzlocke_UpdateRulesActive(saveData)) {
+        return;
+    }
+
+    NuzlockeSave *nz = Save_Nuzlocke_Get(saveData);
+    Party *party = SaveArray_Party_Get(saveData);
+    int count = Party_GetCount(party);
+    int alive = 0;
+    int i;
+
+    for (i = 0; i < count; i++) {
+        if (Nuzlocke_MonCanFight(Party_GetMonByIndex(party, i))) {
+            alive++;
+        }
+    }
+
+    if (alive == 0) {
+        // Wipeout: the run is over. Keep the final team in the party so it
+        // can be shown on the run-over screen, but count them as fallen.
+        for (i = 0; i < count; i++) {
+            Pokemon *mon = Party_GetMonByIndex(party, i);
+            if (GetMonData(mon, MON_DATA_SPECIES_EXISTS, NULL) && !GetMonData(mon, MON_DATA_IS_EGG, NULL) && nz->deaths < 0xFFFF) {
+                nz->deaths++;
+            }
+        }
+#if NUZLOCKE_WIPEOUT_ENDS
+        nz->runOver = TRUE;
+#endif
+        return;
+    }
+
+    for (i = count - 1; i >= 0; i--) {
+        Pokemon *mon = Party_GetMonByIndex(party, i);
+        if (!GetMonData(mon, MON_DATA_SPECIES_EXISTS, NULL) || GetMonData(mon, MON_DATA_IS_EGG, NULL)) {
+            continue;
+        }
+        if (GetMonData(mon, MON_DATA_HP, NULL) == 0) {
+            u8 dead = TRUE;
+            SetMonData(mon, NUZLOCKE_DEAD_MARKER, &dead);
+            if (nz->deaths < 0xFFFF) {
+                nz->deaths++;
+            }
+            Nuzlocke_BuryPartyMon(saveData, party, i);
+        }
+    }
+
+    Nuzlocke_CheckVictory(setup, saveData);
+#endif
+}
+
+void Nuzlocke_FillRecord(SaveData *saveData, NuzlockeRecord *record) {
+    PlayerProfile *profile = Save_PlayerData_GetProfile(saveData);
+    IGT *igt = Save_PlayerData_GetIGTAddr(saveData);
+    Party *party = SaveArray_Party_Get(saveData);
+    int i;
+
+    MI_CpuClear8(record, sizeof(NuzlockeRecord));
+    record->valid = TRUE;
+    record->badges = PlayerProfile_CountBadges(profile);
+    record->deaths = Save_Nuzlocke_Get(saveData)->deaths;
+    record->hours = GetIGTHours(igt);
+    record->minutes = GetIGTMinutes(igt);
+    record->caught = Pokedex_CountDexOwned(Save_Pokedex_Get(saveData));
+    for (i = 0; i < Party_GetCount(party) && record->teamCount < PARTY_SIZE; i++) {
+        Pokemon *mon = Party_GetMonByIndex(party, i);
+        NuzlockeTeamMon *dest;
+        if (!GetMonData(mon, MON_DATA_SPECIES_EXISTS, NULL) || GetMonData(mon, MON_DATA_IS_EGG, NULL)) {
+            continue;
+        }
+        dest = &record->team[record->teamCount++];
+        dest->species = GetMonData(mon, MON_DATA_SPECIES, NULL);
+        dest->level = GetMonData(mon, MON_DATA_LEVEL, NULL);
+        dest->form = GetMonData(mon, MON_DATA_FORM, NULL);
+        GetMonData(mon, MON_DATA_NICKNAME, dest->nickname);
+    }
+}
+
+int Nuzlocke_TakePendingVictory(void) {
+    int ret = sPendingVictory;
+    sPendingVictory = -1;
+    return ret;
+}
+
+static void Nuzlocke_CheckVictory(BattleSetup *setup, SaveData *saveData) {
+#if NUZLOCKE_VICTORY_SCREENS
+    NuzlockeSave *nz = Save_Nuzlocke_Get(saveData);
+    int trainerId = setup->trainerId[BATTLER_ENEMY];
+    int record;
+
+    if (!(setup->battleType & BATTLE_TYPE_TRAINER) || setup->winFlag != BATTLE_OUTCOME_WIN || nz->runOver) {
+        return;
+    }
+    if (trainerId == TRAINER_CHAMPION_LANCE || trainerId == TRAINER_CHAMPION_LANCE_2 || trainerId == TRAINER_CHAMPION_LANCE_3) {
+        record = NUZLOCKE_RECORD_CHAMPION;
+    } else if (trainerId == TRAINER_PKMN_TRAINER_RED_RED) {
+        record = NUZLOCKE_RECORD_RED;
+    } else {
+        return;
+    }
+    if (nz->records[record].valid && !sTestMode) {
+        return; // only the first win is recorded (test mode always shows it)
+    }
+    // Snapshot the winning team (after any deaths in the final battle).
+    Nuzlocke_FillRecord(saveData, &nz->records[record]);
+    sPendingVictory = record;
+#endif
+}
+
+// Called when the player closes the PC. Dead Pokemon can't leave the PC:
+// any that were withdrawn go straight back to the graveyard.
+void Nuzlocke_OnPCClosed(SaveData *saveData) {
+#if NUZLOCKE_PERMADEATH
+    Party *party = SaveArray_Party_Get(saveData);
+    PCStorage *pc = SaveArray_PCStorage_Get(saveData);
+    int i;
+    int box, slot;
+    BOOL hasFighter = FALSE;
+
+    if (!Nuzlocke_UpdateRulesActive(saveData)) {
+        return;
+    }
+
+    for (i = 0; i < Party_GetCount(party); i++) {
+        Pokemon *mon = Party_GetMonByIndex(party, i);
+        if (Nuzlocke_MonCanFight(mon)) {
+            hasFighter = TRUE;
+        }
+    }
+
+    if (!hasFighter) {
+        // The player left only dead Pokemon (or Eggs) in the party. Bring
+        // back the first living Pokemon from the PC so the game can continue.
+        Pokemon *tmp = AllocMonZeroed(HEAP_ID_FIELD2);
+        for (box = 0; box < NUM_BOXES && !hasFighter; box++) {
+            for (slot = 0; slot < MONS_PER_BOX && !hasFighter; slot++) {
+                BoxPokemon *boxMon = PCStorage_GetMonByIndexPair(pc, box, slot);
+                if (!GetBoxMonData(boxMon, MON_DATA_SPECIES_EXISTS, NULL) || GetBoxMonData(boxMon, MON_DATA_IS_EGG, NULL) || GetBoxMonData(boxMon, NUZLOCKE_DEAD_MARKER, NULL)) {
+                    continue;
+                }
+                CopyBoxPokemonToPokemon(boxMon, tmp);
+                if (Party_GetCount(party) >= PARTY_SIZE) {
+                    // Make room by burying a dead party member first.
+                    for (i = Party_GetCount(party) - 1; i >= 0; i--) {
+                        if (Nuzlocke_MonIsDead(Party_GetMonByIndex(party, i))) {
+                            Nuzlocke_BuryPartyMon(saveData, party, i);
+                            break;
+                        }
+                    }
+                }
+                if (Party_AddMon(party, tmp)) {
+                    PCStorage_DeleteBoxMonByIndexPair(pc, box, slot);
+                    hasFighter = TRUE;
+                }
+            }
+        }
+        Heap_Free(tmp);
+    }
+
+    if (!hasFighter) {
+        // Nothing alive anywhere. Leave the party alone; the next battle
+        // will end the run.
+        return;
+    }
+
+    for (i = Party_GetCount(party) - 1; i >= 0; i--) {
+        if (Nuzlocke_MonIsDead(Party_GetMonByIndex(party, i))) {
+            Nuzlocke_BuryPartyMon(saveData, party, i);
+        }
+    }
+#endif
+}
+
+// ------------------------------------------------------------------
+// Test mode
+// ------------------------------------------------------------------
+
+BOOL Nuzlocke_IsTestMode(void) {
+    return sTestMode;
+}
+
+static u32 sTestTrainer;
+static u32 sTestWinFlag;
+
+static BOOL Task_NuzlockeTestBattle(TaskManager *taskManager) {
+    u32 *state = TaskManager_GetStatePtr(taskManager);
+    if (*state == 0) {
+        SetupAndStartTrainerBattle(taskManager, sTestTrainer, 0, 0, 0, 0, HEAP_ID_FIELD2, &sTestWinFlag);
+        (*state)++;
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static void Nuzlocke_GiveTestTeam(FieldSystem *fieldSystem) {
+    static const u16 species[PARTY_SIZE] = { SPECIES_LUGIA, SPECIES_DRAGONITE, SPECIES_TYRANITAR, SPECIES_TYPHLOSION, SPECIES_GENGAR, SPECIES_PIKACHU };
+    SaveData *saveData = fieldSystem->saveData;
+    Party *party = SaveArray_Party_Get(saveData);
+    PlayerProfile *profile = Save_PlayerData_GetProfile(saveData);
+    u32 mapsec = MapHeader_GetMapSec(fieldSystem->location->mapId);
+    int i;
+
+    if (Party_GetCount(party) < PARTY_SIZE) {
+        Pokemon *mon = AllocMonZeroed(HEAP_ID_FIELD2);
+        for (i = Party_GetCount(party); i < PARTY_SIZE; i++) {
+            ZeroMonData(mon);
+            CreateMon(mon, species[i], 100, 31, FALSE, 0, OT_ID_PLAYER_ID, 0);
+            sub_020720FC(mon, profile, ITEM_POKE_BALL, mapsec, 12, HEAP_ID_FIELD2);
+            Party_AddMon(party, mon);
+        }
+        Heap_Free(mon);
+    }
+    // Put a level 100 Pokemon in front.
+    for (i = 1; i < Party_GetCount(party); i++) {
+        if (GetMonData(Party_GetMonByIndex(party, 0), MON_DATA_LEVEL, NULL) >= 100) {
+            break;
+        }
+        Party_SwapSlots(party, 0, i);
+    }
+    // Poke Balls switch the Nuzlocke rules on.
+    if (!Bag_HasItem(Save_Bag_Get(saveData), ITEM_POKE_BALL, 1, HEAP_ID_FIELD2)) {
+        Bag_AddItem(Save_Bag_Get(saveData), ITEM_POKE_BALL, 10, HEAP_ID_FIELD2);
+    }
+}
+
+void Nuzlocke_StartTestBattle(FieldSystem *fieldSystem, BOOL red) {
+    // From here until power-off, nothing is written to the save file
+    // (see FlashWriteChunkInternal in save.c).
+    sTestMode = TRUE;
+    Nuzlocke_GiveTestTeam(fieldSystem);
+    sTestTrainer = red ? TRAINER_PKMN_TRAINER_RED_RED : TRAINER_CHAMPION_LANCE;
+    FieldSystem_CreateTask(fieldSystem, Task_NuzlockeTestBattle, NULL);
+}
