+// ------------------------------------------------------------------
+// Nuzlocke: a small panel to the right of the area sign saying whether
+// the area's first encounter is still available. It uses the sign's own
+// window (columns 17-31 are unused by the sign) with its own palette.
+// ------------------------------------------------------------------
+#define NZ_AREA_PLTT   14
+#define NZ_AREA_COL    17
+#define NZ_AREA_X      (NZ_AREA_COL * 8)
+#define NZ_AREA_W      (32 * 8 - NZ_AREA_X - 2)
+
+enum {
+    NZA_CLEAR,
+    NZA_WHITE,
+    NZA_SHADOW,
+    NZA_PANEL,
+    NZA_GREEN,
+    NZA_RED,
+    NZA_BORDER,
+};
+
+static const u16 sNuzlockeAreaPalette[16] = {
+    [NZA_CLEAR] = RGB(0, 0, 0),
+    [NZA_WHITE] = RGB(31, 31, 31),
+    [NZA_SHADOW] = RGB(3, 3, 6),
+    [NZA_PANEL] = RGB(6, 8, 14),
+    [NZA_GREEN] = RGB(12, 30, 12),
+    [NZA_RED] = RGB(31, 14, 14),
+    [NZA_BORDER] = RGB(20, 22, 28),
+};
+
+static void Nuzlocke_PrintAreaLine(FieldDrawMapNameInfo *info, MsgData *msgData, MessageFormat *msgFmt, u32 msgNo, int y, u8 fg) {
+    String *tmp = String_New(64, HEAP_ID_FIELD1);
+    String *str = String_New(64, HEAP_ID_FIELD1);
+    int width;
+    ReadMsgDataIntoString(msgData, msgNo, tmp);
+    StringExpandPlaceholders(msgFmt, str, tmp);
+    width = FontID_String_GetWidth(FONT_SYSTEM, str, 0);
+    AddTextPrinterParameterizedWithColor(&info->window, FONT_SYSTEM, str, NZ_AREA_X + (width < NZ_AREA_W ? (NZ_AREA_W - width) / 2 : 0), y, TEXT_SPEED_NOTRANSFER, MAKE_TEXT_COLOR(fg, NZA_SHADOW, NZA_PANEL), NULL);
+    String_Delete(str);
+    String_Delete(tmp);
+}
+
+static void Nuzlocke_DrawAreaStatus(FieldDrawMapNameInfo *info) {
+    MsgData *msgData;
+    MessageFormat *msgFmt;
+    s8 status = info->nuzlockeStatus;
+
+    if (status < 0) {
+        return;
+    }
+    DC_FlushRange((void *)sNuzlockeAreaPalette, sizeof(sNuzlockeAreaPalette));
+    GX_LoadBGPltt(sNuzlockeAreaPalette, NZ_AREA_PLTT * 32, sizeof(sNuzlockeAreaPalette));
+
+    FillWindowPixelRect(&info->window, NZA_BORDER, NZ_AREA_X, 0, NZ_AREA_W, 32);
+    FillWindowPixelRect(&info->window, NZA_PANEL, NZ_AREA_X + 1, 1, NZ_AREA_W - 2, 30);
+
+    msgData = NewMsgDataFromNarc(MSGDATA_LOAD_LAZY, NARC_msgdata_msg, msg_0203, HEAP_ID_FIELD1);
+    msgFmt = MessageFormat_New(HEAP_ID_FIELD1);
+    if (status == NUZLOCKE_LOG_EMPTY) {
+        Nuzlocke_PrintAreaLine(info, msgData, msgFmt, msg_0203_00068, 0, NZA_GREEN);
+        Nuzlocke_PrintAreaLine(info, msgData, msgFmt, msg_0203_00078, 15, NZA_GREEN);
+    } else {
+        BOOL ok = NUZLOCKE_LOG_IS_SUCCESS(status);
+        BufferSpeciesName(msgFmt, 0, info->nuzlockeSpecies);
+        Nuzlocke_PrintAreaLine(info, msgData, msgFmt, ok ? msg_0203_00024 : msg_0203_00025, 0, ok ? NZA_GREEN : NZA_RED);
+        Nuzlocke_PrintAreaLine(info, msgData, msgFmt, msg_0203_00077, 15, NZA_WHITE);
+    }
+    MessageFormat_Delete(msgFmt);
+    DestroyMsgData(msgData);
+}
+
 static void PrintMapNameOnIcon(FieldDrawMapNameInfo *info, String *name) {
+    Nuzlocke_DrawAreaStatus(info);
     AddTextPrinterParameterizedWithColor(&info->window, FONT_SYSTEM, name, info->nameX, 8, TEXT_SPEED_INSTANT, MAKE_TEXT_COLOR(1, 2, 0), NULL);
+    if (info->nuzlockeStatus >= 0) {
+        // The panel's tiles use the Nuzlocke palette, not the sign's.
+        CopyWindowToVram(&info->window);
+        BgTilemapRectChangePalette(info->bgConfig, GF_BG_LYR_MAIN_3, NZ_AREA_COL, 0, 32 - NZ_AREA_COL, 4, NZ_AREA_PLTT);
+        BgCommitTilemapBufferToVram(info->bgConfig, GF_BG_LYR_MAIN_3);
+    }
 }
 
