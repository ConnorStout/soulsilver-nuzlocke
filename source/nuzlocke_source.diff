diff --git a/include/nuzlocke.h b/include/nuzlocke.h
new file mode 100644
index 0000000..7296afc
--- /dev/null
+++ b/include/nuzlocke.h
@@ -0,0 +1,136 @@
+#ifndef POKEHEARTGOLD_NUZLOCKE_H
+#define POKEHEARTGOLD_NUZLOCKE_H
+
+// ------------------------------------------------------------------
+// Nuzlocke rules baked into the game.
+//
+// Rules (all start once the player first has a Poke Ball in the bag):
+//  * Encounter rule: only the first random wild encounter in each
+//    area (map section) can be caught. Later wild Pokemon in that
+//    area deflect thrown balls (and the ball is not used up).
+//    Shiny Pokemon are always catchable and never use up an area.
+//    Scripted one-time encounters (legendaries, Sudowoodo, etc.)
+//    and roaming Pokemon do not use up an area.
+//  * Permadeath: a Pokemon at 0 HP after a battle is dead. It is
+//    moved to the locked GRAVEYARD box (last PC box). Dead Pokemon
+//    taken out of the PC are put back when the PC is closed.
+//    Revive items do nothing in battle.
+//  * Nickname rule: the nickname screen always opens after a catch.
+//  * Wipeout = game over: if every Pokemon in the party faints, the
+//    run ends on a final screen (badges, deaths, final team). The
+//    save stays locked on that screen.
+//  * No soft resetting: the L+R+START+SELECT reset is disabled and
+//    the game autosaves after every battle.
+//  * Victory screens: beating the Champion (Lance) and Red for the first
+//    time shows a victory screen. A snapshot of each win is saved and can
+//    be viewed again any time by pressing SELECT in the overworld.
+//  * Test mode: hold L+SELECT (Champion Lance) or R+SELECT (Red) for
+//    5 seconds in the overworld. You get a level 100 team and the battle
+//    starts. From then until the game is restarted NOTHING is written to
+//    the save file, so the real save can't be changed by testing.
+// ------------------------------------------------------------------
+
+#include "global.h"
+
+#include "battle/battle_setup.h"
+#include "field_system.h"
+#include "save.h"
+
+// Toggle individual rules here. Set to 0 to turn a rule off.
+#define NUZLOCKE_ENCOUNTER_RULE  1
+#define NUZLOCKE_SHINY_CLAUSE    1
+#define NUZLOCKE_PERMADEATH      1
+#define NUZLOCKE_FORCE_NICKNAMES 1
+#define NUZLOCKE_WIPEOUT_ENDS    1
+#define NUZLOCKE_AUTOSAVE        1
+#define NUZLOCKE_NO_SOFT_RESET   1
+#define NUZLOCKE_VICTORY_SCREENS 1
+#define NUZLOCKE_RECORDS_ON_SELECT 1
+#define NUZLOCKE_TEST_MODE       1
+#define NUZLOCKE_TEST_HOLD_FRAMES (5 * 30) // the overworld runs at 30 updates per second
+
+#define NUZLOCKE_GRAVEYARD_BOX (NUM_BOXES - 1)
+#define NUZLOCKE_DEAD_MARKER   MON_DATA_UNUSED_RIBBON_53
+
+enum {
+    NUZLOCKE_RECORD_CHAMPION,
+    NUZLOCKE_RECORD_RED,
+    NUZLOCKE_RECORD_MAX,
+};
+
+typedef struct NuzlockeTeamMon {
+    u16 species;
+    u8 level;
+    u8 form;
+    u16 nickname[POKEMON_NAME_LENGTH + 1];
+} NuzlockeTeamMon; // 26 bytes
+
+typedef struct NuzlockeRecord {
+    u8 valid;
+    u8 badges;
+    u16 deaths;
+    u16 hours;
+    u8 minutes;
+    u8 teamCount;
+    u16 caught;
+    u16 padding;
+    NuzlockeTeamMon team[PARTY_SIZE];
+} NuzlockeRecord; // 168 bytes
+
+typedef struct NuzlockeSave {
+    u8 areaUsed[32]; // one bit per map section (MAPSEC_*)
+    u8 rulesActive;
+    u8 runOver;
+    u8 graveyardNamed;
+    u8 padding;
+    u16 deaths;
+    u16 unused;
+    NuzlockeRecord records[NUZLOCKE_RECORD_MAX];
+} NuzlockeSave; // 376 bytes
+
+NuzlockeSave *Save_Nuzlocke_Get(SaveData *saveData);
+BOOL Nuzlocke_UpdateRulesActive(SaveData *saveData);
+BOOL Nuzlocke_IsRunOver(SaveData *saveData);
+u16 Nuzlocke_GetDeaths(SaveData *saveData);
+
+// Field-side hooks
+BOOL Nuzlocke_OnRandomEncounterStart(FieldSystem *fieldSystem, BattleSetup *setup); // returns TRUE if the game should save now
+void Nuzlocke_OnBattleStart(FieldSystem *fieldSystem);
+void Nuzlocke_OnBattleEnd(BattleSetup *setup, FieldSystem *fieldSystem);
+BOOL Nuzlocke_ShouldAutosave(SaveData *saveData);
+void Nuzlocke_OnPCClosed(SaveData *saveData);
+
+void Nuzlocke_FillRecord(SaveData *saveData, NuzlockeRecord *record);
+int Nuzlocke_TakePendingVictory(void); // NUZLOCKE_RECORD_* or -1
+
+// Screens (nuzlocke_screen.c)
+BOOL Task_NuzlockeRunOver(TaskManager *taskManager);
+void Nuzlocke_CallVictoryScreen(TaskManager *taskManager, int record);
+void Nuzlocke_OpenRecords(FieldSystem *fieldSystem);
+
+// Encounter log: the first random encounter of each area and whether it
+// was caught. Shown in the SELECT records and the Pokegear map.
+#define NUZLOCKE_LOG_MAX 120
+enum {
+    NUZLOCKE_LOG_EMPTY,
+    NUZLOCKE_LOG_FAILED,
+    NUZLOCKE_LOG_CAUGHT,
+};
+typedef struct NuzlockeLogEntry {
+    u8 mapsec;
+    u8 status;
+    u16 species;
+} NuzlockeLogEntry;
+int Nuzlocke_GetLogCount(SaveData *saveData);
+const NuzlockeLogEntry *Nuzlocke_GetLogEntry(SaveData *saveData, int index);
+const NuzlockeLogEntry *Nuzlocke_FindLogEntry(SaveData *saveData, u32 mapsec);
+
+// Test mode (RAM only; never saved)
+BOOL Nuzlocke_IsTestMode(void);
+void Nuzlocke_StartTestBattle(FieldSystem *fieldSystem, BOOL red);
+
+// Battle-side queries
+BOOL Nuzlocke_IsCatchBlocked(void);
+BOOL Nuzlocke_RulesActiveInBattle(void);
+
+#endif // POKEHEARTGOLD_NUZLOCKE_H
