+// Fills the message buffers for a death cause and returns its message.
+static s32 NuzScreen_BufferCause(NuzlockeScreen *scr, SaveData *saveData, const NuzlockeDeath *info) {
+    static const u16 sCauseMsgs[NUZLOCKE_CAUSE_MAX] = {
+        [NUZLOCKE_CAUSE_UNKNOWN] = msg_0203_00058,
+        [NUZLOCKE_CAUSE_MOVE] = msg_0203_00033,
+        [NUZLOCKE_CAUSE_SELF_MOVE] = msg_0203_00034,
+        [NUZLOCKE_CAUSE_ALLY_MOVE] = msg_0203_00035,
+        [NUZLOCKE_CAUSE_POISON] = msg_0203_00036,
+        [NUZLOCKE_CAUSE_BURN] = msg_0203_00037,
+        [NUZLOCKE_CAUSE_WEATHER] = msg_0203_00058,
+        [NUZLOCKE_CAUSE_SANDSTORM] = msg_0203_00038,
+        [NUZLOCKE_CAUSE_HAIL] = msg_0203_00039,
+        [NUZLOCKE_CAUSE_OWN_ABILITY] = msg_0203_00040,
+        [NUZLOCKE_CAUSE_RECOIL] = msg_0203_00041,
+        [NUZLOCKE_CAUSE_CRASH] = msg_0203_00042,
+        [NUZLOCKE_CAUSE_CONFUSION] = msg_0203_00043,
+        [NUZLOCKE_CAUSE_DISOBEY] = msg_0203_00044,
+        [NUZLOCKE_CAUSE_CURSE] = msg_0203_00045,
+        [NUZLOCKE_CAUSE_NIGHTMARE] = msg_0203_00046,
+        [NUZLOCKE_CAUSE_BIND] = msg_0203_00047,
+        [NUZLOCKE_CAUSE_LEECH_SEED] = msg_0203_00048,
+        [NUZLOCKE_CAUSE_PERISH_SONG] = msg_0203_00049,
+        [NUZLOCKE_CAUSE_HAZARDS] = msg_0203_00050,
+        [NUZLOCKE_CAUSE_ROUGH_SKIN] = msg_0203_00051,
+        [NUZLOCKE_CAUSE_AFTERMATH] = msg_0203_00052,
+        [NUZLOCKE_CAUSE_BAD_DREAMS] = msg_0203_00053,
+        [NUZLOCKE_CAUSE_ITEM] = msg_0203_00054,
+        [NUZLOCKE_CAUSE_FOE_ITEM] = msg_0203_00055,
+        [NUZLOCKE_CAUSE_DESTINY_BOND] = msg_0203_00056,
+        [NUZLOCKE_CAUSE_FUTURE_SIGHT] = msg_0203_00057,
+    };
+    u8 cause = info->cause < NUZLOCKE_CAUSE_MAX ? info->cause : NUZLOCKE_CAUSE_UNKNOWN;
+
+    BufferSpeciesName(scr->msgFmt, 1, info->foeSpecies);
+    BufferMoveName(scr->msgFmt, 2, info->move);
+    switch (cause) {
+    case NUZLOCKE_CAUSE_MOVE:
+        if (info->foeSpecies == SPECIES_NONE) {
+            return msg_0203_00058;
+        }
+        if (info->trainerId != 0) {
+            NuzScreen_BufferTrainerName(scr, saveData, 0, info->trainerId);
+            return msg_0203_00032;
+        }
+        return msg_0203_00033;
+    case NUZLOCKE_CAUSE_ROUGH_SKIN:
+    case NUZLOCKE_CAUSE_AFTERMATH:
+    case NUZLOCKE_CAUSE_FOE_ITEM:
+    case NUZLOCKE_CAUSE_DESTINY_BOND:
+        if (info->foeSpecies == SPECIES_NONE) {
+            return msg_0203_00058;
+        }
+        break;
+    case NUZLOCKE_CAUSE_SELF_MOVE:
+    case NUZLOCKE_CAUSE_ALLY_MOVE:
+    case NUZLOCKE_CAUSE_RECOIL:
+    case NUZLOCKE_CAUSE_CRASH:
+        if (info->move == 0) {
+            return msg_0203_00058;
+        }
+        break;
+    }
+    return sCauseMsgs[cause];
+}
