+
+#define NZ_LAYER GF_BG_LYR_MAIN_2
+
+// Palette slots
+#define NZ_PLTT_ICON_BASE 8  // 8..11: party icon palettes
+#define NZ_PLTT_UI        14 // UI colors below
+
+// UI palette color indices
+enum {
+    NZC_CLEAR = 0,
+    NZC_WHITE,
+    NZC_SHADOW,
+    NZC_RED,
+    NZC_GOLD,
